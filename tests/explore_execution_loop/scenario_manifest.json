{
  "episode_id": "ALOOP-ZCODE-DOGFOOD-001",
  "lane": 7,
  "purpose": "Fault scenario corpus attacking the autonomous execution loop. Legal terminal outcomes are exactly Recover|Replan|Substitute|Refuse|TypedBlock. The illegal outcome WaitForHumanToNotice is asserted unreachable for EVERY scenario: a scenario whose only path forward is a human noticing means the loop failed.",
  "harness": "pytest (repo-native); every provider/verifier/registry/probe is an in-process fake; execution_class=simulated-in-process unless marked real-dogfood-replay. Deterministic given seed; randomized mode sweeps seeds.",
  "contract": {
    "ExecutionRequest": [
      "work_order",
      "capability_requirements",
      "subject",
      "authority",
      "evidence_requirements",
      "resource_constraints"
    ],
    "ExecutionProvider": [
      "capabilities",
      "transport",
      "availability",
      "cost",
      "concurrency",
      "authority_ceiling",
      "receipt_protocol"
    ],
    "ExecutionReceipt": [
      "work_order_id",
      "origin_authority",
      "provider",
      "provider_execution_id",
      "subject_before",
      "subject_after",
      "commands",
      "consequences",
      "evidence",
      "exit_status",
      "timestamps",
      "replay_binding"
    ],
    "receipt_ext_namespaces": [
      "aloup.outcome",
      "aloup.fault",
      "aloup.ocel_digest",
      "aloup.seed",
      "aloup.execution_class"
    ],
    "ocel_object_types": [
      "subject",
      "originAuthority",
      "provider",
      "worker",
      "receipt"
    ],
    "standings": [
      "AUTONOMOUS",
      "ASSISTED",
      "BLOCKED_AUTHORITY",
      "BLOCKED_INFORMATION",
      "FAILED",
      "ALIVE",
      "PARTIAL_ALIVE",
      "BLOCKED",
      "REFUSED",
      "UNSUPPORTED",
      "UNKNOWN"
    ],
    "illegal_transitions": [
      "ASSISTED -> AUTONOMOUS"
    ]
  },
  "repos": {
    "gymact": {
      "status": "PRESENT",
      "role": "short/high-intensity perturbation worlds; owns this corpus"
    },
    "lifegym": {
      "status": "BLOCKED_INFORMATION:lifegym checkout absent",
      "role": "long-horizon multi-stage episodes with silent state changes; scenarios L7-F31 run as simulated-in-process fakes inside the gymact harness; lifegym-native real-world versions remain unmanufactured"
    }
  },
