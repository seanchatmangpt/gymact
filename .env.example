# Copy to .env (already gitignored). act's --env-file (default filename
# .env) injects these directly into every job container's PROCESS
# environment — this is what tests/test_dspy_verifier_chicago.py's
# _groq_key_available() actually checks via os.environ.get(...), NOT the
# GitHub Actions `secrets.` expression context. No workflow-YAML edit is
# needed for this to take effect.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dummy value only — litellm's own provider-validation requires an
# OPENAI_API_KEY-shaped string to exist even though only Groq is ever called
# (model strings like "groq/openai/gpt-oss-20b" are a litellm provider-prefix
# quirk, not a real OpenAI dependency; see src/gymact/gyms/sregym.py:955-968).
# Never put a real OpenAI key here.
OPENAI_API_KEY=sk-dummy-not-used-groq-routing-only
