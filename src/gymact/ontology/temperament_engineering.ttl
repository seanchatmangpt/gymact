# Temperament Engineering vocabulary profile.
#
# Public-vocabulary rule: local gymact URNs below are SKOS concept/scheme
# instances only. No local RDF/OWL predicates or classes are defined.
#
# Source: Hunt, "Temperament Engineering: Designing Strategic Behavioural
# Diversity in Robot Swarms", arXiv:2609.29423 (2026).

@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:gymact:temperament-scheme>
    a skos:ConceptScheme ;
    dct:title "Temperament Engineering behavioral axes" ;
    dct:source <https://arxiv.org/abs/2609.29423> .

<urn:gymact:temperament-axis:boldness>
    a skos:Concept ;
    skos:inScheme <urn:gymact:temperament-scheme> ;
    skos:notation "boldness" ;
    skos:prefLabel "Shyness–boldness"@en ;
    dct:type "animal-temperament-axis" ;
    dct:source <https://arxiv.org/abs/2609.29423> .

