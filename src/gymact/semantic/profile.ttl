@prefix gymact: <urn:gymact:> .
@prefix prof:   <http://www.w3.org/ns/dx/prof/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# GymAct is a public-ontology application profile, not a competing vocabulary.
# See .claude/rules/ontology.md for the full term-replacement table this follows.
# The only local (gymact:) IRIs below are: this profile resource, one SHACL shape,
# and two SKOS concepts distinguishing read-only vs. consequential capabilities —
# exactly the categories ontology.md permits for local terms.

gymact:profile
    a prof:Profile, prov:Entity ;
    dcterms:title "GymAct" ;
    dcterms:description
        "Application profile for benchmark/gym capabilities: constrains sosa:Procedure instances so every capability declares a title and a consequence class." ;
    prof:isProfileOf
        <https://www.w3.org/TR/prov-o/>,
        <https://www.w3.org/TR/vocab-ssn/>,
        <https://www.w3.org/TR/shacl/> ;
    prof:hasResource gymact:CapabilityShape .

# Consequence class: whether invoking a capability requires actuation authority.
# See .claude/rules/actuation-authority.md.
gymact:consequence-read
    a skos:Concept ;
    skos:prefLabel "READ"@en ;
    skos:definition "Observation only; sosa:Observation. Never requires authority."@en .

gymact:consequence-do
    a skos:Concept ;
    skos:prefLabel "DO"@en ;
    skos:definition "Consequential actuation; sosa:Actuation. Requires an authority reference."@en .

gymact:CapabilityShape
    a sh:NodeShape ;
    sh:targetClass sosa:Procedure ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A capability must declare exactly one dcterms:title." ;
    ] ;
    sh:property [
        sh:path dcterms:type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( gymact:consequence-read gymact:consequence-do ) ;
        sh:message "A capability must declare dcterms:type as gymact:consequence-read or gymact:consequence-do." ;
    ] .
