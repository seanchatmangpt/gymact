# Copy to .secrets (gitignored). Used for act's own action-resolution rate
# limit and for authenticating the external-repo checkouts in
# enterprise-connection-crown.yml.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Never set here: leave gcp-empirical-campaign.yml's GCP_ACCESS_TOKEN
# unprovisioned by default. That workflow must only ever be dry-run
# (`act -n`) locally — real execution with allow_do=true spends real GCP
# resources against a live project.
