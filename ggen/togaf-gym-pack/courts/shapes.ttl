# GymAct TOGAF gym admission/falsification courts.
# Local terms are SHACL shape / EARL criterion instances only.

@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:gymact:togaf:shape:task> a sh:NodeShape, earl:TestCriterion ;
    dct:title "TOGAF gym task projection contract"@en ;
    sh:targetClass pplan:Plan ;
    sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:conformsTo ; sh:hasValue <urn:gymact:togaf:profile> ; sh:minCount 1 ] ;
    sh:property [ sh:path dct:requires ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path prov:hadPrimarySource ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

<urn:gymact:togaf:shape:requirement> a sh:NodeShape, earl:TestCriterion ;
    dct:title "OSLC requirement traceability court"@en ;
    sh:targetClass oslc_rm:Requirement ;
    sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path oslc_rm:specifiedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path oslc_rm:validatedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

<urn:gymact:togaf:oracle:preliminary> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Architecture capability oracle"@en ;
    sh:targetNode <urn:gymact:togaf:org:architecture-office> ;
    sh:class org:OrganizationalUnit ;
    sh:property [ sh:path org:unitOf ; sh:hasValue <urn:gymact:togaf:enterprise:northstar> ] .

<urn:gymact:togaf:oracle:requirements> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Requirement closure oracle"@en ;
    sh:targetNode <urn:gymact:togaf:req:continuity>, <urn:gymact:togaf:req:residency>, <urn:gymact:togaf:req:latency>, <urn:gymact:togaf:req:cost> ;
    sh:class oslc_rm:Requirement ;
    sh:property [ sh:path oslc_rm:specifiedBy ; sh:hasValue <urn:gymact:togaf:architecture:target> ] ;
    sh:property [ sh:path oslc_rm:validatedBy ; sh:hasValue <urn:gymact:togaf:oracle:requirements> ] .

<urn:gymact:togaf:oracle:a> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Architecture vision oracle"@en ;
    sh:targetNode <urn:gymact:togaf:artifact:vision> ;
    sh:property [ sh:path dct:type ; sh:hasValue <urn:gymact:togaf:artifact-kind:vision> ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:architecture:baseline> ] .

<urn:gymact:togaf:oracle:b> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Business target oracle"@en ;
    sh:targetNode <urn:gymact:togaf:architecture:business-target> ;
    sh:property [ sh:path dct:type ; sh:hasValue <urn:gymact:togaf:domain:business> ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:architecture:baseline> ] .

<urn:gymact:togaf:oracle:c> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Information systems target oracle"@en ;
    sh:targetNode <urn:gymact:togaf:architecture:data-target>, <urn:gymact:togaf:architecture:application-target> ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:architecture:baseline> ] .

<urn:gymact:togaf:oracle:d> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Technology target oracle"@en ;
    sh:targetNode <urn:gymact:togaf:architecture:technology-target> ;
    sh:property [ sh:path dct:type ; sh:hasValue <urn:gymact:togaf:domain:technology> ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:architecture:baseline> ] .

<urn:gymact:togaf:oracle:e> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Solution portfolio oracle"@en ;
    sh:targetNode <urn:gymact:togaf:artifact:options> ;
    sh:property [ sh:path dct:type ; sh:hasValue <urn:gymact:togaf:artifact-kind:options> ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:architecture:target> ] .

<urn:gymact:togaf:oracle:f> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Migration roadmap oracle"@en ;
    sh:targetNode <urn:gymact:togaf:artifact:roadmap> ;
    sh:property [ sh:path dct:type ; sh:hasValue <urn:gymact:togaf:artifact-kind:roadmap> ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:artifact:options> ] .

<urn:gymact:togaf:oracle:g> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Implementation governance oracle"@en ;
    sh:targetNode <urn:gymact:togaf:policy:governance> ;
    sh:class odrl:Set ;
    sh:property [ sh:path odrl:uid ; sh:hasValue <urn:gymact:togaf:policy:governance> ] ;
    sh:property [ sh:path odrl:permission ; sh:minCount 1 ] .

<urn:gymact:togaf:oracle:h> a sh:NodeShape, earl:TestCriterion ;
    dct:title "Architecture change oracle"@en ;
    sh:targetNode <urn:gymact:togaf:artifact:change> ;
    sh:property [ sh:path dct:type ; sh:hasValue <urn:gymact:togaf:artifact-kind:change> ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:hasValue <urn:gymact:togaf:artifact:conformance> ] .
