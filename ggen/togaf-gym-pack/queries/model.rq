PREFIX dct: <http://purl.org/dc/terms/>
PREFIX pplan: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?recordKind ?notation ?label ?id ?title ?phase ?family ?oracle WHERE {
  {
    ?resource a skos:Concept ;
      skos:inScheme <urn:gymact:togaf:scheme:adm-phase> ;
      skos:notation ?notation ;
      skos:prefLabel ?label .
    BIND("phase" AS ?recordKind)
  }
  UNION
  {
    ?resource a pplan:Plan ;
      dct:identifier ?id ;
      dct:title ?title ;
      dct:type ?familyIri ;
      dct:requires ?oracle ;
      prov:wasDerivedFrom ?phaseIri .
    ?familyIri skos:prefLabel ?family .
    ?phaseIri skos:notation ?phase .
    BIND("task" AS ?recordKind)
  }
}
ORDER BY ?recordKind ?notation ?id
