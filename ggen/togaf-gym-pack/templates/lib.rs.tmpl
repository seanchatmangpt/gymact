//! Ephemeral projection of the admitted public-ontology graph.
//! The RDF graph and ggen rules are canonical; this file is not.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct AdmPhase {
    pub notation: &'static str,
    pub label: &'static str,
}

pub const ADM_PHASES: &[AdmPhase] = &[
{% for row in results %}{% if row["recordKind"] == "phase" %}    AdmPhase { notation: "{{ row["notation"] }}", label: "{{ row["label"] }}" },
{% endif %}{% endfor %}];

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ArchitectureTask {
    pub id: &'static str,
    pub title: &'static str,
    pub phase: &'static str,
    pub family: &'static str,
    pub oracle: &'static str,
}

pub const TASKS: &[ArchitectureTask] = &[
{% for row in results %}{% if row["recordKind"] == "task" %}    ArchitectureTask {
        id: "{{ row["id"] }}",
        title: "{{ row["title"] }}",
        phase: "{{ row["phase"] }}",
        family: "{{ row["family"] }}",
        oracle: "{{ row["oracle"] }}",
    },
{% endif %}{% endfor %}];

pub fn task(id: &str) -> Option<&'static ArchitectureTask> {
    TASKS.iter().find(|candidate| candidate.id == id)
}

pub fn tasks_for_phase(phase: &str) -> Vec<&'static ArchitectureTask> {
    TASKS.iter().filter(|candidate| candidate.phase == phase).collect()
}
