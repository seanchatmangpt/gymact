---
to: "src/lib.rs"
force: true
shape:
  - shapes.ttl
sparql:
  phases: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?notation ?label WHERE {
      ?phase a skos:Concept ; skos:inScheme <urn:gymact:togaf:scheme:adm-phase> ; skos:notation ?notation ; skos:prefLabel ?label .
    } ORDER BY ?notation
  tasks: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX pplan: <http://purl.org/net/p-plan#>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?id ?title ?phase ?family ?oracle WHERE {
      ?task a pplan:Plan ; dct:identifier ?id ; dct:title ?title ; dct:type ?family_iri ; dct:requires ?oracle ; prov:wasDerivedFrom ?phase_iri .
      ?family_iri skos:prefLabel ?family .
      ?phase_iri skos:notation ?phase .
    } ORDER BY ?id
---
//! Ephemeral projection of `ggen/togaf-gym-pack/ontology.ttl`.
//! The admitted RDF graph is canonical; this file is not.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct AdmPhase { pub notation: &'static str, pub label: &'static str }
pub const ADM_PHASES: &[AdmPhase] = &[
{% for row in phases -%}
    AdmPhase { notation: "{{ row.notation }}", label: "{{ row.label }}" },
{% endfor -%}
];

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ArchitectureTask { pub id: &'static str, pub title: &'static str, pub phase: &'static str, pub family: &'static str, pub oracle: &'static str }
pub const TASKS: &[ArchitectureTask] = &[
{% for row in tasks -%}
    ArchitectureTask { id: "{{ row.id }}", title: "{{ row.title }}", phase: "{{ row.phase }}", family: "{{ row.family }}", oracle: "{{ row.oracle }}" },
{% endfor -%}
];

pub fn task(id: &str) -> Option<&'static ArchitectureTask> { TASKS.iter().find(|candidate| candidate.id == id) }
pub fn tasks_for_phase(phase: &str) -> Vec<&'static ArchitectureTask> { TASKS.iter().filter(|candidate| candidate.phase == phase).collect() }
