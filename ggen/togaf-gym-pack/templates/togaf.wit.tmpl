---
to: "wit/gymact-togaf-gym.wit"
force: true
shape:
  - shapes.ttl
sparql:
  tasks: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX pplan: <http://purl.org/net/p-plan#>
    SELECT ?id WHERE { ?task a pplan:Plan ; dct:identifier ?id . } ORDER BY ?id
---
package gymact:togaf-gym@0.1.0;

interface architecture-gym {
    record task {
        id: string,
        title: string,
        phase: string,
        family: string,
        oracle: string,
    }

{% for row in tasks -%}
    // admitted-task: {{ row.id }}
{% endfor -%}
    list-tasks: func() -> list<task>;
    evaluate-rdf-submission: func(task-id: string, turtle: string) -> string;
}

world togaf-gym {
    export architecture-gym;
}
