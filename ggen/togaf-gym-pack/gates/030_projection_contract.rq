# MESSAGE: every projected architecture task must be fully grounded.
# Any row identifies a missing projection fact or an invalid classification.
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX pplan: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?task ?problem WHERE {
  {
    ?task a pplan:Plan .
    VALUES ?required { dct:identifier dct:title dct:type dct:conformsTo dct:requires prov:wasDerivedFrom prov:hadPrimarySource }
    FILTER NOT EXISTS { ?task ?required ?value }
    BIND(CONCAT("missing:", STR(?required)) AS ?problem)
  }
  UNION
  {
    ?task a pplan:Plan ; dct:type ?family .
    FILTER NOT EXISTS { ?family a skos:Concept ; skos:inScheme <urn:gymact:togaf:scheme:task-family> . }
    BIND("invalid-task-family" AS ?problem)
  }
  UNION
  {
    ?task a pplan:Plan ; prov:wasDerivedFrom ?phase .
    FILTER NOT EXISTS { ?phase a skos:Concept ; skos:inScheme <urn:gymact:togaf:scheme:adm-phase> . }
    BIND("invalid-adm-phase" AS ?problem)
  }
  UNION
  {
    ?task a pplan:Plan ; dct:requires ?oracle .
    FILTER NOT EXISTS { ?oracle a <http://www.w3.org/ns/shacl#NodeShape> . }
    BIND("invalid-oracle" AS ?problem)
  }
}
ORDER BY ?task ?problem
