# GymAct TOGAF alignment: public ontologies own semantics; local IRIs are ABox/SKOS only.
@prefix t: <urn:gymact:togaf:> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix rm: <http://open-services.net/ns/rm#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

t:profile a prof:Profile, prov:Entity ;
  dct:identifier "gymact-togaf-public-ontology-profile" ;
  dct:title "GymAct TOGAF public-ontology alignment profile"@en ;
  dct:conformsTo <https://publications.opengroup.org/standards/togaf> ;
  prof:isProfileOf <http://www.w3.org/ns/prov#>, <http://www.w3.org/ns/org#>,
    <http://www.w3.org/2004/02/skos/core#>, <http://purl.org/net/p-plan#>,
    <http://open-services.net/ns/rm#>, <http://www.w3.org/ns/dcat#>,
    <http://www.w3.org/ns/odrl/2/> ;
  prov:hadPrimarySource t:source:standard, t:source:adm .
t:source:standard a dcat:Resource, prov:Entity ; dct:identifier "TOGAF-10" ;
  dcat:landingPage <https://publications.opengroup.org/standards/togaf> .
t:source:adm a dcat:Resource, prov:Entity ; dct:identifier "OPEN-GROUP-PUBLIC-ADM-PHASE-LABELS" ;
  dcat:landingPage <https://www.opengroup.org/soa/source-book/togaf/p4.htm> .

t:scheme:adm-phase a skos:ConceptScheme ; prov:hadPrimarySource t:source:adm .
t:phase:preliminary a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "Preliminary" ; skos:prefLabel "Preliminary Phase"@en ; prov:hadPrimarySource t:source:adm .
t:phase:requirements a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "Requirements" ; skos:prefLabel "Architecture Requirements Management"@en ; prov:hadPrimarySource t:source:adm .
t:phase:a a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "A" ; skos:prefLabel "Architecture Vision"@en ; prov:hadPrimarySource t:source:adm .
t:phase:b a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "B" ; skos:prefLabel "Business Architecture"@en ; prov:hadPrimarySource t:source:adm .
t:phase:c a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "C" ; skos:prefLabel "Information Systems Architectures"@en ; prov:hadPrimarySource t:source:adm .
t:phase:d a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "D" ; skos:prefLabel "Technology Architecture"@en ; prov:hadPrimarySource t:source:adm .
t:phase:e a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "E" ; skos:prefLabel "Opportunities and Solutions"@en ; prov:hadPrimarySource t:source:adm .
t:phase:f a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "F" ; skos:prefLabel "Migration Planning"@en ; prov:hadPrimarySource t:source:adm .
t:phase:g a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "G" ; skos:prefLabel "Implementation Governance"@en ; prov:hadPrimarySource t:source:adm .
t:phase:h a skos:Concept ; skos:inScheme t:scheme:adm-phase ; skos:notation "H" ; skos:prefLabel "Architecture Change Management"@en ; prov:hadPrimarySource t:source:adm .

t:scheme:task-family a skos:ConceptScheme .
t:task-family:capability a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Architecture capability"@en .
t:task-family:requirements a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Requirements traceability"@en .
t:task-family:vision a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Architecture vision"@en .
t:task-family:business a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Business baseline-to-target"@en .
t:task-family:information-systems a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Information-systems baseline-to-target"@en .
t:task-family:technology a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Technology baseline-to-target"@en .
t:task-family:options a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Opportunity and solution portfolio"@en .
t:task-family:migration a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Migration planning"@en .
t:task-family:governance a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Implementation conformance"@en .
t:task-family:change a skos:Concept ; skos:inScheme t:scheme:task-family ; skos:prefLabel "Architecture change"@en .

t:domain:business a skos:Concept ; skos:prefLabel "Business"@en .
t:domain:data a skos:Concept ; skos:prefLabel "Data"@en .
t:domain:application a skos:Concept ; skos:prefLabel "Application"@en .
t:domain:technology a skos:Concept ; skos:prefLabel "Technology"@en .
t:artifact-kind:baseline a skos:Concept ; skos:prefLabel "Baseline architecture"@en .
t:artifact-kind:target a skos:Concept ; skos:prefLabel "Target architecture"@en .
t:artifact-kind:vision a skos:Concept ; skos:prefLabel "Architecture vision"@en .
t:artifact-kind:options a skos:Concept ; skos:prefLabel "Solution options"@en .
t:artifact-kind:roadmap a skos:Concept ; skos:prefLabel "Migration roadmap"@en .
t:artifact-kind:conformance a skos:Concept ; skos:prefLabel "Conformance evidence"@en .
t:artifact-kind:change a skos:Concept ; skos:prefLabel "Architecture change"@en .

t:enterprise:northstar a org:FormalOrganization, prov:Agent ; org:hasUnit t:org:architecture-office, t:org:architecture-board .
t:org:architecture-office a org:OrganizationalUnit, prov:Agent ; org:unitOf t:enterprise:northstar .
t:org:architecture-board a org:OrganizationalUnit, prov:Agent ; org:unitOf t:enterprise:northstar .
t:role:enterprise-architect a org:Role, skos:Concept .
t:agent:lead-architect a prov:Agent .
t:membership:lead-architect a org:Membership ; org:organization t:org:architecture-office ; org:member t:agent:lead-architect ; org:role t:role:enterprise-architect .

t:req:continuity a rm:Requirement, prov:Entity ; dct:identifier "REQ-001" ; dct:title "Regional service continuity"@en ; rm:specifiedBy t:architecture:target ; rm:validatedBy t:oracle:requirements .
t:req:residency a rm:Requirement, prov:Entity ; dct:identifier "REQ-002" ; dct:title "Regulated-data residency"@en ; rm:specifiedBy t:architecture:target ; rm:validatedBy t:oracle:requirements .
t:req:latency a rm:Requirement, prov:Entity ; dct:identifier "REQ-003" ; dct:title "Interactive-channel latency"@en ; rm:specifiedBy t:architecture:target ; rm:validatedBy t:oracle:requirements .
t:req:cost a rm:Requirement, prov:Entity ; dct:identifier "REQ-004" ; dct:title "Bounded operating cost"@en ; rm:specifiedBy t:architecture:target ; rm:validatedBy t:oracle:requirements .

t:architecture:baseline a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:baseline .
t:artifact:vision a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:vision ; prov:wasDerivedFrom t:architecture:baseline .
t:architecture:business-target a dcat:Resource, prov:Entity ; dct:type t:domain:business ; prov:wasDerivedFrom t:architecture:baseline .
t:architecture:data-target a dcat:Resource, prov:Entity ; dct:type t:domain:data ; prov:wasDerivedFrom t:architecture:baseline .
t:architecture:application-target a dcat:Resource, prov:Entity ; dct:type t:domain:application ; prov:wasDerivedFrom t:architecture:baseline .
t:architecture:technology-target a dcat:Resource, prov:Entity ; dct:type t:domain:technology ; prov:wasDerivedFrom t:architecture:baseline .
t:architecture:target a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:target ; prov:wasDerivedFrom t:architecture:baseline, t:architecture:business-target, t:architecture:data-target, t:architecture:application-target, t:architecture:technology-target .
t:artifact:options a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:options ; prov:wasDerivedFrom t:architecture:target .
t:artifact:roadmap a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:roadmap ; prov:wasDerivedFrom t:artifact:options .
t:artifact:conformance a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:conformance ; prov:wasDerivedFrom t:architecture:target .
t:artifact:change a dcat:Resource, prov:Entity ; dct:type t:artifact-kind:change ; prov:wasDerivedFrom t:artifact:conformance .

t:policy:governance a odrl:Set, prov:Entity ; odrl:uid t:policy:governance ;
  odrl:permission [ a odrl:Permission ; odrl:target t:architecture:target ; odrl:action odrl:use ; odrl:assigner t:org:architecture-board ; odrl:assignee t:org:architecture-office ] .

t:task:preliminary a pplan:Plan, prov:Plan ; dct:identifier "togaf.00.preliminary" ; dct:title "Establish the architecture capability"@en ; dct:type t:task-family:capability ; dct:conformsTo t:profile ; dct:subject t:enterprise:northstar ; dct:requires t:oracle:preliminary ; prov:wasDerivedFrom t:phase:preliminary ; prov:hadPrimarySource t:source:adm .
t:task:requirements a pplan:Plan, prov:Plan ; dct:identifier "togaf.01.requirements" ; dct:title "Close requirement traceability"@en ; dct:type t:task-family:requirements ; dct:conformsTo t:profile ; dct:subject t:req:continuity, t:req:residency, t:req:latency, t:req:cost ; dct:requires t:oracle:requirements ; prov:wasDerivedFrom t:phase:requirements ; prov:hadPrimarySource t:source:adm .
t:task:a a pplan:Plan, prov:Plan ; dct:identifier "togaf.10.phase-a" ; dct:title "Manufacture an architecture vision"@en ; dct:type t:task-family:vision ; dct:conformsTo t:profile ; dct:subject t:artifact:vision ; dct:requires t:oracle:a ; prov:wasDerivedFrom t:phase:a ; prov:hadPrimarySource t:source:adm .
t:task:b a pplan:Plan, prov:Plan ; dct:identifier "togaf.20.phase-b" ; dct:title "Transform the business architecture"@en ; dct:type t:task-family:business ; dct:conformsTo t:profile ; dct:subject t:architecture:business-target ; dct:requires t:oracle:b ; prov:wasDerivedFrom t:phase:b ; prov:hadPrimarySource t:source:adm .
t:task:c a pplan:Plan, prov:Plan ; dct:identifier "togaf.30.phase-c" ; dct:title "Transform data and application architectures"@en ; dct:type t:task-family:information-systems ; dct:conformsTo t:profile ; dct:subject t:architecture:data-target, t:architecture:application-target ; dct:requires t:oracle:c ; prov:wasDerivedFrom t:phase:c ; prov:hadPrimarySource t:source:adm .
t:task:d a pplan:Plan, prov:Plan ; dct:identifier "togaf.40.phase-d" ; dct:title "Transform the technology architecture"@en ; dct:type t:task-family:technology ; dct:conformsTo t:profile ; dct:subject t:architecture:technology-target ; dct:requires t:oracle:d ; prov:wasDerivedFrom t:phase:d ; prov:hadPrimarySource t:source:adm .
t:task:e a pplan:Plan, prov:Plan ; dct:identifier "togaf.50.phase-e" ; dct:title "Preserve a solution option portfolio"@en ; dct:type t:task-family:options ; dct:conformsTo t:profile ; dct:subject t:artifact:options ; dct:requires t:oracle:e ; prov:wasDerivedFrom t:phase:e ; prov:hadPrimarySource t:source:adm .
t:task:f a pplan:Plan, prov:Plan ; dct:identifier "togaf.60.phase-f" ; dct:title "Manufacture a migration roadmap"@en ; dct:type t:task-family:migration ; dct:conformsTo t:profile ; dct:subject t:artifact:roadmap ; dct:requires t:oracle:f ; prov:wasDerivedFrom t:phase:f ; prov:hadPrimarySource t:source:adm .
t:task:g a pplan:Plan, prov:Plan ; dct:identifier "togaf.70.phase-g" ; dct:title "Prove implementation conformance"@en ; dct:type t:task-family:governance ; dct:conformsTo t:profile ; dct:subject t:artifact:conformance, t:policy:governance ; dct:requires t:oracle:g ; prov:wasDerivedFrom t:phase:g ; prov:hadPrimarySource t:source:adm .
t:task:h a pplan:Plan, prov:Plan ; dct:identifier "togaf.80.phase-h" ; dct:title "Evaluate an architecture change"@en ; dct:type t:task-family:change ; dct:conformsTo t:profile ; dct:subject t:artifact:change ; dct:requires t:oracle:h ; prov:wasDerivedFrom t:phase:h ; prov:hadPrimarySource t:source:adm .
