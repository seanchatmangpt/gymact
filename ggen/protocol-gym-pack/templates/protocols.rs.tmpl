---
to: "src/protocols.rs"
force: true
sparql:
  protocols: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id ?title WHERE {
      ?protocol a skos:Concept ; dct:identifier ?id ; dct:title ?title .
      FILTER(?id IN ("mcp", "a2a", "lsp"))
    } ORDER BY ?id
---
pub const PROTOCOLS: &[(&str, &str)] = &[
{% for row in protocols -%}
    ("{{ row.id }}", "{{ row.title }}"),
{% endfor -%}
];
