@prefix dct: <http://purl.org/dc/terms/> .
@prefix mcp: <urn:gymact:mcp:> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mcp:client-extensions a mcp:Capability ;
    mcp:capabilityKey "extensions" ;
    mcp:capabilitySide "client" ;
    mcp:lifecycle mcp:Active .

mcp:facet-authorization a skos:Concept,
        mcp:Facet ;
    dct:identifier "authorization" ;
    skos:prefLabel "Authorization" .

mcp:facet-content a skos:Concept,
        mcp:Facet ;
    dct:identifier "content" ;
    skos:prefLabel "Content and schemas" .

mcp:facet-errors a skos:Concept,
        mcp:Facet ;
    dct:identifier "errors" ;
    skos:prefLabel "Errors" .

mcp:facet-extensions a skos:Concept,
        mcp:Facet ;
    dct:identifier "extensions" ;
    skos:prefLabel "Extensions" .

mcp:facet-transport a skos:Concept,
        mcp:Facet ;
    dct:identifier "transport" ;
    skos:prefLabel "Transport" .

mcp:gymact-brce-do-policy a odrl:Policy,
        prov:Entity ;
    dct:description "An MCP tool projection classified DO by its admitted ontology may not execute merely because tools/call is valid; it must be converted to a GymAct actuation intent and pass capability scope plus authority admission." ;
    dct:title "GymAct BRCE consequence policy for MCP tools" ;
    odrl:prohibition [ a odrl:Prohibition ;
            odrl:action odrl:execute ;
            odrl:target mcp:ConditionalEffect ] .

mcp:header-param-mirror a mcp:Header ;
    dct:description "x-mcp-header projects selected tool arguments into HTTP headers; the body remains the semantic source of truth." ;
    mcp:bodySource mcp:json-schema-2020-12 ;
    mcp:headerName "Mcp-Param-*" ;
    mcp:inRevision mcp:revision-2026-07-28 ;
    mcp:lifecycle mcp:Active ;
    mcp:mismatchRefusal "HEADER_MISMATCH" .

mcp:header-protocol-version a mcp:Header ;
    mcp:bodySource mcp:meta-protocol-version ;
    mcp:headerName "MCP-Protocol-Version" ;
    mcp:inRevision mcp:revision-2026-07-28 ;
    mcp:lifecycle mcp:Active ;
    mcp:mismatchRefusal "UNSUPPORTED_OR_MISMATCHED_PROTOCOL_VERSION" .

mcp:http-oauth-resource-policy a odrl:Policy,
        prov:Entity ;
    dct:conformsTo mcp:revision-2026-07-28 ;
    dct:description "When authorization is used with HTTP MCP, the MCP server acts as an OAuth resource server and bearer credentials are carried at the HTTP layer." ;
    dct:title "MCP HTTP OAuth resource-server profile" ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:use ;
            odrl:target mcp:transport-streamable-http ] .

mcp:invariant-deprecated-compat-only a mcp:Invariant ;
    dct:title "Removed features are compatibility-only" ;
    mcp:reasonCode "MCP_REMOVED_FEATURE_IN_MODERN_PROFILE" .

mcp:invariant-exact-revision a mcp:Invariant ;
    dct:title "Exact protocol revision" ;
    mcp:reasonCode "MCP_PROTOCOL_REVISION_MISMATCH" .

mcp:invariant-extension-negotiation a mcp:Invariant ;
    dct:title "Extension methods require negotiated extension support" ;
    mcp:reasonCode "MCP_EXTENSION_NOT_NEGOTIATED" .

mcp:invariant-header-body-consistency a mcp:Invariant ;
    dct:title "HTTP mirrors cannot disagree with the JSON-RPC body" ;
    mcp:reasonCode "MCP_HEADER_BODY_MISMATCH" .

mcp:invariant-method-closure a mcp:Invariant ;
    dct:title "Current method closure equals the admitted revision" ;
    mcp:reasonCode "MCP_METHOD_CLOSURE_MISMATCH" .

mcp:invariant-no-ambient-do a mcp:Invariant ;
    dct:title "MCP validity never grants GymAct DO authority" ;
    mcp:reasonCode "MCP_AMBIENT_DO_REFUSED" .

