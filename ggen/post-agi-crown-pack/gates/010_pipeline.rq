# MESSAGE: Crown plan must expose exactly 12 ordered p-plan:Step instances.
PREFIX pplan: <http://purl.org/net/p-plan#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?count WHERE {
  {
    SELECT (COUNT(?step) AS ?count) WHERE {
      ?step a pplan:Step ;
            pplan:isStepOfPlan <urn:gymact:crown:plan> ;
            dct:identifier ?order ;
            dct:title ?title .
    }
  }
  FILTER(?count != 12)
}
