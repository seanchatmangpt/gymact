# MESSAGE: post-AGI Crown manufacture requires at least 10 ggen-owned projection targets.
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?count WHERE {
  {
    SELECT (COUNT(?projection) AS ?count) WHERE {
      ?projection a prov:Entity ;
                  dct:type <urn:gymact:crown:concept:projection> ;
                  dct:identifier ?path .
    }
  }
  FILTER(?count < 10)
}
