---
to: "rust/crown/src/replay.rs"
force: true
sparql:
  stages: |
    PREFIX pplan: <http://purl.org/net/p-plan#>
    SELECT ?stage WHERE { ?stage a pplan:Step ; pplan:isStepOfPlan <urn:gymact:crown:plan> . }
---
pub const REPLAY_REQUIRES_RECEIPT: bool = true;
pub const REPLAY_REQUIRES_EXACT_SUBJECT: bool = true;
pub const REPLAY_REQUIRES_EXACT_EXPERIMENT: bool = true;

pub fn admit_replay(receipt_bound: bool, exact_identity: bool, consequence_verified: bool) -> Result<(), &'static str> {
    if !receipt_bound { return Err("REFUSED:CROWN:REPLAY_RECEIPT_MISSING"); }
    if !exact_identity { return Err("REFUSED:CROWN:REPLAY_IDENTITY_DRIFT"); }
    if !consequence_verified { return Err("REFUSED:CROWN:REPLAY_CONSEQUENCE_UNVERIFIED"); }
    Ok(())
}
