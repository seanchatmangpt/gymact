---
to: "rust/crown/src/stages.rs"
force: true
sparql:
  stages: |
    PREFIX pplan: <http://purl.org/net/p-plan#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?order ?id ?title WHERE {
      ?stage a pplan:Step ; pplan:isStepOfPlan <urn:gymact:crown:plan> ; dct:identifier ?order ; dct:title ?title .
      BIND(STRAFTER(STR(?stage), "urn:gymact:crown:stage:") AS ?id)
    }
    ORDER BY ?order
---
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Stage { pub order: &'static str, pub id: &'static str, pub title: &'static str }

pub const STAGES: &[Stage] = &[
{% for row in stages -%}
    Stage { order: "{{ row.order }}", id: "{{ row.id }}", title: "{{ row.title }}" },
{% endfor -%}
];

pub fn stage(id: &str) -> Option<&'static Stage> { STAGES.iter().find(|stage| stage.id == id) }
