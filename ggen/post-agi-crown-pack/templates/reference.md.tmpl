to: "docs/crown-compiled-reference.md"
force: true
sparql:
  stages: |
    PREFIX pplan: <http://purl.org/net/p-plan#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?order ?id ?title WHERE { ?stage a pplan:Step ; pplan:isStepOfPlan <urn:gymact:crown:plan> ; dct:identifier ?order ; dct:title ?title . BIND(STRAFTER(STR(?stage), "urn:gymact:crown:stage:") AS ?id) } ORDER BY ?order
  evidence: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id ?title WHERE { ?evidence a skos:Concept ; skos:broader <urn:gymact:crown:concept:evidence-dimension> ; dct:identifier ?id ; dct:title ?title . } ORDER BY ?id
  metrics: |
    PREFIX dqv: <http://www.w3.org/ns/dqv#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id ?title WHERE { ?metric a dqv:Metric ; dqv:inDimension <urn:gymact:crown:dimension:sota> ; dct:identifier ?id ; dct:title ?title . } ORDER BY ?id
  transports: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id ?title WHERE { ?transport a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier ?id ; dct:title ?title . } ORDER BY ?id
  projections: |
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?path ?title WHERE { ?projection a prov:Entity ; dct:type <urn:gymact:crown:concept:projection> ; dct:identifier ?path ; dct:title ?title . } ORDER BY ?path
