---
to: "rust/crown/Cargo.toml"
force: true
sparql:
  plan: |
    PREFIX pplan: <http://purl.org/net/p-plan#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?title WHERE { <urn:gymact:crown:plan> a pplan:Plan ; dct:title ?title . }
---
[package]
name = "gymact-crown"
version = "26.8.8"
edition = "2021"
{% for row in plan -%}
description = "{{ row.title }}"
{% endfor -%}
license = "MIT"
publish = false

[lib]
path = "src/lib.rs"

[dependencies]
