<urn:gymact:crown:transport:http> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "http" ; dct:title "HTTP" .
<urn:gymact:crown:transport:cli> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "cli" ; dct:title "CLI" .
<urn:gymact:crown:transport:bpmn> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "bpmn" ; dct:title "BPMN" .
<urn:gymact:crown:transport:powl> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "powl" ; dct:title "POWL" .
<urn:gymact:crown:transport:a2a> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "a2a" ; dct:title "A2A" .
<urn:gymact:crown:transport:cloud_api> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "cloud_api" ; dct:title "Cloud API" .
<urn:gymact:crown:transport:wasm> a skos:Concept ; skos:broader <urn:gymact:crown:concept:transport> ; dct:identifier "wasm" ; dct:title "WASM" .

<urn:gymact:crown:projection:rust-crown-Cargo-toml> a prov:Entity ; dct:type <urn:gymact:crown:concept:projection> ; dct:identifier "rust/crown/Cargo.toml" ; dct:title "Rust crate manifest" ; prov:wasDerivedFrom <urn:gymact:crown:plan> .
