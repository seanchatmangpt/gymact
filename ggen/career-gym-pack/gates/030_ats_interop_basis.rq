# MESSAGE: Fortune-5 ATS profile is missing an interoperability basis.
PREFIX cg: <urn:gymact:careergym:>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vc: <https://www.w3.org/2018/credentials#>
SELECT ?problem WHERE {
  VALUES (?required ?type ?problem) {
    (cg:atsCandidateProfile schema:ProfilePage "missing-candidate-profile")
    (cg:currentResume schema:CreativeWork "missing-resume")
    (cg:jobApplication schema:ApplyAction "missing-application")
    (cg:assessment schema:AssessAction "missing-assessment-stage")
    (cg:interviewEvent schema:Event "missing-interview-stage")
    (cg:offer schema:Offer "missing-offer-stage")
    (cg:credentialEnvelope vc:VerifiableCredential "missing-vc-envelope")
    (cg:applicationConsentPolicy odrl:Policy "missing-consent-policy")
    (cg:escoMapping prov:Activity "missing-esco-mapping")
    (cg:onetMapping prov:Activity "missing-onet-mapping")
    (cg:workdayProjection prov:Activity "missing-workday-projection")
    (cg:successFactorsProjection prov:Activity "missing-successfactors-projection")
    (cg:oracleProjection prov:Activity "missing-oracle-projection")
  }
  FILTER NOT EXISTS { ?required a ?type . }
}
ORDER BY ?problem
