@prefix cg: <urn:gymact:careergym:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CareerGym is intentionally an ABox/profile over public ontologies.
# No cg:* class or property is declared.

cg:careerGymProfile
    a prov:Entity, schema:CreativeWork ;
    schema:name "CareerGym public-semantic profile" ;
    schema:description "A bounded career-process world model for observing opportunities, constructing application alternatives, executing authorized career actions, and preserving receipts without inventing a private career ontology." ;
    dcterms:conformsTo <https://schema.org/>,
        <http://www.w3.org/ns/prov-o#>,
        <http://purl.org/net/p-plan#>,
        <http://www.w3.org/ns/odrl/2/>,
        <http://www.w3.org/2004/02/skos/core>,
        <http://www.w3.org/2006/time> .

cg:sean
    a schema:Person, prov:Agent ;
    schema:name "Sean Chatman" ;
    schema:homeLocation [
        a schema:Place ;
        schema:name "Pasadena, California"
    ] ;
    schema:url <https://github.com/seanchatmangpt> .

cg:currentResume
    a schema:CreativeWork, prov:Entity ;
    schema:name "Sean Chatman — Principal Forward Deployed Engineer / Agentic AI Architect Resume" ;
    schema:author cg:sean ;
    schema:about cg:skill-ai-ml, cg:skill-python, cg:skill-aws, cg:skill-docker, cg:skill-kubernetes, cg:skill-data-science .

cg:skills
    a skos:ConceptScheme ;
    skos:prefLabel "CareerGym skill vocabulary" .

cg:skill-ai-ml a skos:Concept ; skos:inScheme cg:skills ; skos:prefLabel "AI/ML engineering" .
cg:skill-python a skos:Concept ; skos:inScheme cg:skills ; skos:prefLabel "Python" .
cg:skill-aws a skos:Concept ; skos:inScheme cg:skills ; skos:prefLabel "AWS" .
cg:skill-docker a skos:Concept ; skos:inScheme cg:skills ; skos:prefLabel "Docker" .
cg:skill-kubernetes a skos:Concept ; skos:inScheme cg:skills ; skos:prefLabel "Kubernetes" .
cg:skill-data-science a skos:Concept ; skos:inScheme cg:skills ; skos:prefLabel "Data Science" .

cg:recruiterMessage-2026-08-10
    a schema:Message, prov:Entity ;
    schema:recipient cg:sean ;
    schema:dateReceived "2026-08-10"^^xsd:date ;
    schema:text "Long-term AI engineer or ML/AI Data Science opportunity; two 12-month+ contract roles with a massive auto manufacturer/brand; on-site Torrance CA or Marysville OH with flex schedule; Python, AWS, Docker, AI/ML and data focused; resume requested to move candidate to top of inbox." ;
    prov:wasDerivedFrom cg:recruiterObservation-2026-08-10 .

cg:recruiterObservation-2026-08-10
    a prov:Activity ;
    prov:generated cg:recruiterMessage-2026-08-10 ;
    prov:wasAssociatedWith cg:sean .

cg:unknownAutoManufacturer
    a schema:Organization ;
    schema:name "Unidentified massive auto manufacturer/brand" .

cg:torrance
    a schema:Place ;
    schema:name "Torrance, California" ;
    schema:address [ a schema:PostalAddress ; schema:addressLocality "Torrance" ; schema:addressRegion "CA" ; schema:addressCountry "US" ] .

cg:marysville
    a schema:Place ;
    schema:name "Marysville, Ohio" ;
    schema:address [ a schema:PostalAddress ; schema:addressLocality "Marysville" ; schema:addressRegion "OH" ; schema:addressCountry "US" ] .

cg:aiEngineerPosting
    a schema:JobPosting, prov:Entity ;
    schema:title "AI Engineer" ;
    schema:hiringOrganization cg:unknownAutoManufacturer ;
    schema:employmentType "CONTRACT" ;
    schema:jobLocation cg:torrance, cg:marysville ;
    schema:workHours "Flex schedule" ;
    schema:skills "Python; AWS; Docker; AI/ML engineering; data" ;
    schema:description "12 month contract+; on-site in Torrance CA or Marysville OH; AI/ML and data focused." ;
    prov:wasDerivedFrom cg:recruiterMessage-2026-08-10 .

cg:mlDataSciencePosting
    a schema:JobPosting, prov:Entity ;
    schema:title "ML/AI Data Science" ;
    schema:hiringOrganization cg:unknownAutoManufacturer ;
    schema:employmentType "CONTRACT" ;
    schema:jobLocation cg:torrance, cg:marysville ;
    schema:workHours "Flex schedule" ;
    schema:skills "Python; AWS; Docker; machine learning; data science" ;
    schema:description "12 month contract+; on-site in Torrance CA or Marysville OH; ML/AI and data focused." ;
    prov:wasDerivedFrom cg:recruiterMessage-2026-08-10 .

cg:careerPlan
    a p-plan:Plan, prov:Plan ;
    dcterms:title "CareerGym opportunity-to-close process" ;
    dcterms:description "Observe broadly, preserve multiple lawful opportunity/application paths, admit only evidence-backed actions, execute through explicit authority, verify consequences, and close every admitted object with terminal standing." .

cg:step-observe a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; dcterms:title "Observe opportunity and context" .
cg:step-normalize a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-observe ; dcterms:title "Normalize job, organization, location, compensation, contract, and recruiter facts" .
cg:step-match a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-normalize ; dcterms:title "Construct evidence-backed skill and experience correspondence" .
cg:step-options a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-match ; dcterms:title "Preserve reversible application/resume/message alternatives" .
cg:step-admit a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-options ; dcterms:title "Admit a closure-capable application path" .
cg:step-resume a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-admit ; dcterms:title "Construct role-specific resume projection from admitted evidence" .
cg:step-message a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-resume ; dcterms:title "Construct recruiter response" .
cg:step-send a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-message ; dcterms:title "Execute authorized send/submission" .
cg:step-verify a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-send ; dcterms:title "Observe delivery/application consequence independently" .
cg:step-wait a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-verify ; dcterms:title "Represent external waiting dependency without creating human WIP" .
cg:step-schedule a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-wait ; dcterms:title "Schedule recruiter/interview event when invited" .
cg:step-interview a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-schedule ; dcterms:title "Prepare and execute interview episode" .
cg:step-followup a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-interview ; dcterms:title "Execute evidence-backed follow-up" .
cg:step-offer a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-followup ; dcterms:title "Evaluate offer/terms as a decision space" .
cg:step-close a p-plan:Step ; p-plan:isStepOfPlan cg:careerPlan ; p-plan:isPrecededBy cg:step-offer ; dcterms:title "Close opportunity with terminal standing and receipt" .

cg:applicationPolicy
    a odrl:Policy ;
    odrl:permission [
        a odrl:Permission ;
        odrl:target cg:currentResume ;
        odrl:action odrl:use
    ] .

cg:sendResumeIntent
    a schema:SendAction, prov:Activity ;
    schema:agent cg:sean ;
    schema:object cg:currentResume ;
    schema:recipient cg:unknownAutoManufacturer ;
    schema:actionStatus schema:PotentialActionStatus ;
    prov:used cg:aiEngineerPosting, cg:mlDataSciencePosting .

cg:responseWindow
    a time:Interval ;
    time:hasBeginning [ a time:Instant ; time:inXSDDate "2026-08-10"^^xsd:date ] .
