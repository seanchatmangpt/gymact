//! Full-coverage cross-check proof -- GENERATED by `ggen sync` from this
//! pack's own `ontology.ttl`. Walks BOTH
//! `gymact_multicloud_operation_catalog::OPERATIONS` and
//! `gymact_multicloud_mcp_tools::MCP_TOOLS` -- two independently generated
//! modules, each backed by its own separately-issued SPARQL SELECT
//! against the same admitted graph -- and asserts they agree on every
//! field for every admitted operation. If either template's SPARQL
//! projection silently dropped, mistyped, or diverged on a field, this
//! test fails on that exact operation without a human needing to
//! enumerate the graph by hand.
//!
//! Do not edit by hand.

use std::path::PathBuf;

#[path = "../src/gymact_multicloud_operation_catalog.rs"]
mod gymact_multicloud_operation_catalog;
#[path = "../src/gymact_multicloud_mcp_tools.rs"]
mod gymact_multicloud_mcp_tools;

use gymact_multicloud_mcp_tools::MCP_TOOLS;
use gymact_multicloud_operation_catalog::OPERATIONS;

fn reference_doc_path() -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("docs/multicloud-gym/reference.md")
}

/// Every admitted operation appears in BOTH generated modules, with
/// matching `consequence_class` -- proving the two independently-issued
/// SPARQL projections agree, not merely that each individually "looks
/// generated".
#[test]
fn catalog_and_mcp_tools_agree_on_every_admitted_operation() {
    assert_eq!(
        OPERATIONS.len(),
        MCP_TOOLS.len(),
        "catalog and MCP tool schema must cover the same number of operations"
    );
    let mut mismatched = Vec::new();
    for op in OPERATIONS {
        let tool_name = format!("multicloud.{}", op.id);
        match gymact_multicloud_mcp_tools::lookup_mcp_tool(&tool_name) {
            None => mismatched.push(format!("{}: missing from MCP_TOOLS", op.id)),
            Some(tool) => {
                if tool.consequence_class != op.consequence_class {
                    mismatched.push(format!(
                        "{}: consequence_class mismatch (catalog={}, mcp={})",
                        op.id, op.consequence_class, tool.consequence_class
                    ));
                }
            }
        }
    }
    assert!(
        mismatched.is_empty(),
        "catalog/MCP-tools divergence: {mismatched:?}"
    );
}

/// Every admitted operation's `consequence_class` is either "Read" or
/// "Do" -- the real GymAct classification, not a third, invented value.
#[test]
fn every_operation_has_a_real_consequence_class() {
    for op in OPERATIONS {
        assert!(
            op.consequence_class == "Read" || op.consequence_class == "Do",
            "{}: unexpected consequence_class {:?}",
            op.id,
            op.consequence_class
        );
    }
}

/// No duplicate operation ids -- a structural invariant no single
/// hand-picked spot-check could catch.
#[test]
fn no_duplicate_operation_ids() {
    let mut ids: Vec<&str> = OPERATIONS.iter().map(|op| op.id).collect();
    ids.sort_unstable();
    let len = ids.len();
    ids.dedup();
    assert_eq!(ids.len(), len, "duplicate operation id in generated OPERATIONS");
}

/// `lookup_operation`/`operations_by_consequence_class` are real behavior
/// over the admitted facts, exercised end-to-end rather than left uncalled.
#[test]
fn lookup_functions_exercise_real_behavior_over_every_row() {
    for op in OPERATIONS {
        assert_eq!(
            gymact_multicloud_operation_catalog::lookup_operation(op.id).map(|o| o.id),
            Some(op.id)
        );
    }
    assert!(
        gymact_multicloud_operation_catalog::lookup_operation("__not_a_real_operation__").is_none()
    );

    let do_ops = gymact_multicloud_operation_catalog::operations_by_consequence_class("Do");
    let read_ops = gymact_multicloud_operation_catalog::operations_by_consequence_class("Read");
    assert_eq!(
        do_ops.len() + read_ops.len(),
        OPERATIONS.len(),
        "Read + Do partition must cover every operation exactly once"
    );
}

/// Every generated operation row appears verbatim (`| \`id\` | class |`)
/// in the rendered reference doc, formatted exactly as
/// `bridge_reference.md.tmpl` itself formats a row.
#[test]
fn all_operations_render_verbatim_in_reference_doc() {
    let content = std::fs::read_to_string(reference_doc_path())
        .unwrap_or_else(|e| panic!("read {}: {e}", reference_doc_path().display()));
    let mut missing = Vec::new();
    for op in OPERATIONS {
        let expected = format!("| `{}` | {} |", op.id, op.consequence_class);
        if !content.contains(&expected) {
            missing.push(op.id);
        }
    }
    assert!(
        missing.is_empty(),
        "operation rows missing from rendered reference.md: {missing:?}"
    );
}
