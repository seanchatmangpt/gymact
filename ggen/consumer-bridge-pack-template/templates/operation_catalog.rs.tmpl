---
to: "src/gymact_consumer_operation_catalog.rs"
shape:
  - shapes/profile.shacl.ttl
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?consequence_class
    WHERE {
      ?cap a sosa:Procedure ;
           dct:title ?id ;
           dct:type ?consequence_class_iri .
      BIND(IF(CONTAINS(STR(?consequence_class_iri), "consequence:do"), "Do", "Read") AS ?consequence_class)
    }
    ORDER BY ?id
---
//! Generated `OPERATIONS` catalog -- GENERATED by `ggen sync` from this
//! pack's own `ontology.ttl`. That file is YOUR ontology, not GymAct's:
//! it should declare YOUR system's real `sosa:Procedure` capability
//! facts (whatever capabilities your provider actually exposes to
//! GymAct), each validated at sync time against GymAct's real SHACL
//! constraint (`shapes/profile.shacl.ttl`'s `urn:gymact:shape:capability`
//! -- fetched via `gymact export-profile`, see this pack's README, never
//! hand-copied or re-derived).
//!
//! `consequence_class` is either "Read" or "Do", resolved from GymAct's
//! real consequence-class IRIs (`urn:gymact:consequence:read`/
//! `urn:gymact:consequence:do`), not a locally-invented vocabulary. This
//! is the one invariant this template exists to carry over into your own
//! system: observing the world is not the same operation as actuating
//! it, using GymAct's own real classification, never a project-local one.
//!
//! Do not edit by hand: this is a pure projection of your admitted graph.

/// One `sosa:Procedure` individual from YOUR ontology, satisfying
/// GymAct's real `urn:gymact:shape:capability` SHACL shape.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Operation {
    pub id: &'static str,
    pub consequence_class: &'static str,
}

/// All {{ ops | length }} admitted operations, ordered by `id`.
pub const OPERATIONS: &[Operation] = &[
{% for row in ops -%}
    Operation { id: "{{ row.id }}", consequence_class: "{{ row.consequence_class }}" },
{% endfor -%}
];

/// Look up an operation by its `dct:title`.
pub fn lookup_operation(id: &str) -> Option<&'static Operation> {
    OPERATIONS.iter().find(|op| op.id == id)
}

/// All operations in a given consequence class ("Read" or "Do"), in
/// `OPERATIONS` order -- real behavior over the admitted facts, not just a
/// static string table.
pub fn operations_by_consequence_class(consequence_class: &str) -> Vec<&'static Operation> {
    OPERATIONS
        .iter()
        .filter(|op| op.consequence_class == consequence_class)
        .collect()
}

/// Count of admitted operations -- independently derived from the same
/// graph the reference doc's own header-count summarizes, so a proof can
/// cross-check the two without either being the other's oracle.
pub fn operation_count() -> usize {
    OPERATIONS.len()
}
