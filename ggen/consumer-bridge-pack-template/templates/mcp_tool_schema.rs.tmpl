/// One generated MCP tool's schema (name and the real GymAct consequence
/// class it was classified under, per `urn:gymact:shape:capability`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct McpToolSchema {
    /// MCP tool name, namespaced under your own system's slug -- replace
    /// the `consumer.` placeholder prefix below before real use.
    pub name: &'static str,
    /// "Read" (sosa:Observation-shaped) or "Do" (sosa:Actuation-shaped),
    /// per GymAct's real `urn:gymact:consequence:{read,do}` classification.
    pub consequence_class: &'static str,
}

/// All {{ ops | length }} generated MCP tool schemas, one per admitted
/// `sosa:Procedure`, ordered by tool name.
pub const MCP_TOOLS: &[McpToolSchema] = &[
{% for row in ops -%}
    McpToolSchema { name: "consumer.{{ row.id }}", consequence_class: "{{ row.consequence_class }}" },
{% endfor -%}
];

/// Look up a generated tool schema by its full `<your-slug>.<id>` name.
pub fn lookup_mcp_tool(name: &str) -> Option<&'static McpToolSchema> {
    MCP_TOOLS.iter().find(|t| t.name == name)
}

/// Tool schemas classified `Do` -- the subset whose real execution
/// requires a fail-closed `AuthorityResolver` decision (matching GymAct's
/// own boundary, see `~/gymact/src/gymact/runtime.py`) before it may
/// cause a consequence.
pub fn do_class_tools() -> Vec<&'static McpToolSchema> {
    MCP_TOOLS
        .iter()
        .filter(|t| t.consequence_class == "Do")
        .collect()
}

/// Count of generated tool schemas.
pub fn mcp_tool_count() -> usize {
    MCP_TOOLS.len()
}
