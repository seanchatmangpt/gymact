# MESSAGE: SREGym MCP/E2E ontology must preserve its exact subject, capability
# partition, corpus and deterministic-program closure. Any returned row refuses
# generation. Runtime ALIVE standing is intentionally outside this structural gate.
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX sr: <urn:gymact:sregym:mcp:>

SELECT ?violation WHERE {
  {
    FILTER NOT EXISTS {
      <urn:gymact:sregym:e2e:contract>
        a <http://www.w3.org/ns/prov#Entity> ;
        dct:identifier "sregym-e2e" ;
        dct:source <https://github.com/SREGym/SREGym> ;
        dct:hasVersion "ba07faf1a322f9b6d4a279643bb796aa2f36f64b" ;
        dct:conformsTo <urn:gymact:profile:v26.8.7>, <urn:gymact:mcp:revision-2026-07-28> .
    }
    BIND("subject-contract" AS ?violation)
  }
  UNION
  {
    <urn:gymact:sregym:e2e:contract> dct:hasVersion ?revision .
    FILTER(?revision != "ba07faf1a322f9b6d4a279643bb796aa2f36f64b")
    BIND(CONCAT("revision-shadow:", STR(?revision)) AS ?violation)
  }
  UNION
  {
    { SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability . } }
    FILTER(?count != 14)
    BIND(CONCAT("capability-count:", STR(?count)) AS ?violation)
  }
  UNION
  {
    { SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability ; sr:consequence sr:READ . } }
    FILTER(?count != 11)
    BIND(CONCAT("read-count:", STR(?count)) AS ?violation)
  }
  UNION
  {
    { SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability ; sr:consequence sr:DO . } }
    FILTER(?count != 3)
    BIND(CONCAT("do-count:", STR(?count)) AS ?violation)
  }
  UNION
  { ?cap a sr:Capability ; sr:consequence sr:DO ; sr:authorityRequired false . BIND(CONCAT("do-without-authority:", STR(?cap)) AS ?violation) }
  UNION
  { ?cap a sr:Capability ; sr:consequence sr:READ ; sr:authorityRequired true . BIND(CONCAT("read-requires-authority:", STR(?cap)) AS ?violation) }
  UNION
  { ?cap a sr:Capability . FILTER NOT EXISTS { ?cap sr:binding ?binding } BIND(CONCAT("capability-missing-binding:", STR(?cap)) AS ?violation) }
  UNION
  { ?cap a sr:Capability . FILTER NOT EXISTS { ?cap dct:relation ?route . ?route sr:routePath ?path } BIND(CONCAT("capability-missing-route:", STR(?cap)) AS ?violation) }
  UNION
  {
    { SELECT (COUNT(DISTINCT ?subject) AS ?count) WHERE { ?subject a sr:CorpusSubject ; sr:problemId ?problem . } }
    FILTER(?count != 21)
    BIND(CONCAT("corpus-count:", STR(?count)) AS ?violation)
  }
  UNION
  {
    { SELECT (COUNT(DISTINCT ?program) AS ?count) WHERE { ?program a sr:Program ; sr:problemId ?problem . } }
    FILTER(?count != 2)
    BIND(CONCAT("program-count:", STR(?count)) AS ?violation)
  }
  UNION
  { ?program a sr:Program ; sr:problemId ?problem . FILTER NOT EXISTS { ?subject a sr:CorpusSubject ; sr:problemId ?problem } BIND(CONCAT("program-outside-corpus:", ?problem) AS ?violation) }
  UNION
  { ?step a sr:ProgramStep ; sr:stepCapability ?cap . FILTER NOT EXISTS { ?cap a sr:Capability } BIND(CONCAT("step-capability-not-admitted:", STR(?step)) AS ?violation) }
  UNION
  { ?step a sr:ProgramStep . FILTER NOT EXISTS { ?step sr:inProgram ?program ; sr:stepOrder ?order ; sr:payloadTemplateJson ?payload ; sr:purpose ?purpose ; sr:sourceRef ?source } BIND(CONCAT("incomplete-program-step:", STR(?step)) AS ?violation) }
  UNION
  {
    VALUES ?path { "src/gymact/generated/sregym_mcp_catalog.py" "rust/sregym_e2e/src/lib.rs" "rust/sregym_e2e/wit/sregym-e2e.wit" }
    FILTER NOT EXISTS { ?target a sr:ProjectionTarget ; sr:projectionPath ?path }
    BIND(CONCAT("missing-projection:", ?path) AS ?violation)
  }
}
ORDER BY ?violation
