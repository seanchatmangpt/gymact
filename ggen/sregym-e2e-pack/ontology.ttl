# Program 1: wrong DNS policy.
sr:program-wrong-dns a sr:Program ; sr:problemId "wrong_dns_policy_astronomy_shop" ;
    sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/wrong_dns_policy.py#WrongDNSPolicy.recover_fault;blob=630627e4c4d3f69f477e857252972b397757f68c" ;
    sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/generators/fault/inject_virtual.py#VirtualizationFaultInjector.recover_wrong_dns_policy" .

sr:wd-1 a sr:ProgramStep ; sr:inProgram sr:program-wrong-dns ; sr:stepOrder 1 ; sr:stepCapability <urn:gymact:sregym:capability:submit_diagnosis> ; sr:payloadTemplateJson "{\"component\":\"frontend\",\"cause\":\"deployment frontend has dnsPolicy=None and an external 8.8.8.8 resolver, breaking cluster-internal DNS resolution\",\"gdmcp_source\":\"SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/wrong_dns_policy.py#WrongDNSPolicy.recover_fault;blob=630627e4c4d3f69f477e857252972b397757f68c\"}" ; sr:purpose "submit the source-grounded diagnosis; no model inference" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/wrong_dns_policy.py#WrongDNSPolicy.recover_fault;blob=630627e4c4d3f69f477e857252972b397757f68c" .
sr:wd-2 a sr:ProgramStep ; sr:inProgram sr:program-wrong-dns ; sr:stepOrder 2 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl patch deployment frontend -n {{namespace}} --type=json -p='[{\\\"op\\\":\\\"remove\\\",\\\"path\\\":\\\"/spec/template/spec/dnsPolicy\\\"},{\\\"op\\\":\\\"remove\\\",\\\"path\\\":\\\"/spec/template/spec/dnsConfig\\\"}]'\"}" ; sr:purpose "restore the deployment to normal ClusterFirst DNS semantics" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/generators/fault/inject_virtual.py#VirtualizationFaultInjector.recover_wrong_dns_policy" .
sr:wd-3 a sr:ProgramStep ; sr:inProgram sr:program-wrong-dns ; sr:stepOrder 3 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl rollout status deployment frontend -n {{namespace}} --timeout=120s\"}" ; sr:purpose "wait for the repaired deployment to become stable" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/generators/fault/inject_virtual.py#VirtualizationFaultInjector.recover_wrong_dns_policy" .
sr:wd-4 a sr:ProgramStep ; sr:inProgram sr:program-wrong-dns ; sr:stepOrder 4 ; sr:stepCapability <urn:gymact:sregym:capability:submit_mitigation> ; sr:payloadTemplateJson "{\"action\":\"removed the injected dnsPolicy/dnsConfig override and waited for the frontend rollout\",\"gdmcp_source\":\"SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/generators/fault/inject_virtual.py#VirtualizationFaultInjector.recover_wrong_dns_policy\"}" ; sr:purpose "submit the deterministic mitigation evidence" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/generators/fault/inject_virtual.py#VirtualizationFaultInjector.recover_wrong_dns_policy" .

# Program 2: internalTrafficPolicy Local.
sr:program-internal-traffic a sr:Program ; sr:problemId "internal_traffic_policy_local_astronomy_shop" ;
    sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .

sr:it-1 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 1 ; sr:stepCapability <urn:gymact:sregym:capability:submit_diagnosis> ; sr:payloadTemplateJson "{\"component\":\"service/recommendation\",\"cause\":\"internalTrafficPolicy=Local plus pinned recommendation/frontend pods causes cross-node in-cluster requests to be dropped\",\"gdmcp_source\":\"SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4\"}" ; sr:purpose "submit the source-grounded diagnosis; no model inference" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-2 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 2 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl patch service recommendation -n {{namespace}} --type=merge -p '{\\\"spec\\\":{\\\"internalTrafficPolicy\\\":\\\"Cluster\\\"}}'\"}" ; sr:purpose "restore cluster-wide service routing" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-3 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 3 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl patch deployment recommendation -n {{namespace}} --type=merge -p '{\\\"spec\\\":{\\\"template\\\":{\\\"spec\\\":{\\\"nodeSelector\\\":null}}}}'\"}" ; sr:purpose "remove fault-only recommendation node pinning" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-4 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 4 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl rollout restart deployment/recommendation -n {{namespace}}\"}" ; sr:purpose "restart recommendation after topology repair" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-5 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 5 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl patch deployment frontend -n {{namespace}} --type=merge -p '{\\\"spec\\\":{\\\"template\\\":{\\\"spec\\\":{\\\"nodeSelector\\\":null}}}}'\"}" ; sr:purpose "remove fault-only frontend node pinning" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-6 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 6 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl rollout restart deployment/frontend -n {{namespace}}\"}" ; sr:purpose "restart frontend after topology repair" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-7 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 7 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl rollout status deployment/recommendation -n {{namespace}} --timeout=180s\"}" ; sr:purpose "wait for recommendation convergence" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-8 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 8 ; sr:stepCapability <urn:gymact:sregym:capability:run_kubectl> ; sr:payloadTemplateJson "{\"command\":\"kubectl rollout status deployment/frontend -n {{namespace}} --timeout=180s\"}" ; sr:purpose "wait for frontend convergence" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .
sr:it-9 a sr:ProgramStep ; sr:inProgram sr:program-internal-traffic ; sr:stepOrder 9 ; sr:stepCapability <urn:gymact:sregym:capability:submit_mitigation> ; sr:payloadTemplateJson "{\"action\":\"restored internalTrafficPolicy=Cluster, removed both injected nodeSelectors, and waited for both deployments to roll out\",\"gdmcp_source\":\"SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4\"}" ; sr:purpose "submit the deterministic mitigation evidence" ; sr:sourceRef "SREGym/SREGym@ba07faf1a322f9b6d4a279643bb796aa2f36f64b:sregym/conductor/problems/internal_traffic_policy_local.py#InternalTrafficPolicyLocalAstronomyShop.recover_fault;blob=4264df2c1b88845df120aec09bb9583292f652d4" .

# ggen projection targets.  The Python catalog is consumed by the runtime;
# Rust/WIT keep the independent Gall checkpoint.
sr:projection-python-catalog a sr:ProjectionTarget ; sr:projectionPath "src/gymact/generated/sregym_mcp_catalog.py" .
sr:projection-rust a sr:ProjectionTarget ; sr:projectionPath "rust/sregym_e2e/src/lib.rs" .
sr:projection-wit a sr:ProjectionTarget ; sr:projectionPath "rust/sregym_e2e/wit/sregym-e2e.wit" .
