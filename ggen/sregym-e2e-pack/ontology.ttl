@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sr: <urn:gymact:sregym:mcp:> .

# SREGym's exact-pinned semantic source.  This ABox owns the protocol bindings,
# consequence classifications, and deterministic known-solution programs.  The
# Python/FastMCP/Rust/WIT artifacts are projections, never a second source of truth.
<urn:gymact:sregym:e2e:contract>
    a prov:Entity ;
    dct:identifier "sregym-e2e" ;
    dct:title "SREGym GymAct end-to-end evidence contract" ;
    dct:source <https://github.com/SREGym/SREGym> ;
    dct:hasVersion "ba07faf1a322f9b6d4a279643bb796aa2f36f64b" ;
    dct:conformsTo <urn:gymact:profile:v26.8.7>, <urn:gymact:mcp:revision-2026-07-28> ;
    dct:requires <urn:gymact:sregym:e2e:evidence:authority-admitted>,
                 <urn:gymact:sregym:e2e:evidence:native-result-artifact-read>,
                 <urn:gymact:sregym:e2e:evidence:ocel-schema-valid>,
                 <urn:gymact:sregym:e2e:evidence:replay-conformant> .

<urn:gymact:sregym:e2e:evidence:authority-admitted> a prov:Entity ; dct:identifier "authority-admitted" .
<urn:gymact:sregym:e2e:evidence:native-result-artifact-read> a prov:Entity ; dct:identifier "native-result-artifact-read" .
<urn:gymact:sregym:e2e:evidence:ocel-schema-valid> a prov:Entity ; dct:identifier "ocel-schema-valid" .
<urn:gymact:sregym:e2e:evidence:replay-conformant> a prov:Entity ; dct:identifier "replay-conformant" .

# ---------------------------------------------------------------------------
# Local irreducible MCP/domain binding vocabulary.
# ---------------------------------------------------------------------------
sr:Capability a rdfs:Class .
sr:Program a rdfs:Class .
sr:ProgramStep a rdfs:Class .
sr:CorpusSubject a rdfs:Class .
sr:ProjectionTarget a rdfs:Class .

sr:binding a rdf:Property .
sr:consequence a rdf:Property .
sr:routePath a rdf:Property .
sr:toolName a rdf:Property .
sr:transportKind a rdf:Property .
sr:authorityRequired a rdf:Property .
sr:payloadSchemaJson a rdf:Property .
sr:problemId a rdf:Property .
sr:stepOrder a rdf:Property .
sr:stepCapability a rdf:Property .
sr:payloadTemplateJson a rdf:Property .
sr:purpose a rdf:Property .
sr:sourceRef a rdf:Property .
sr:inProgram a rdf:Property .
sr:projectionPath a rdf:Property .

sr:READ a skos:Concept ; skos:prefLabel "READ" .
sr:DO a skos:Concept ; skos:prefLabel "DO" .
sr:SSE a skos:Concept ; skos:prefLabel "SSE compatibility transport" .
sr:HTTP a skos:Concept ; skos:prefLabel "HTTP" .

# ---------------------------------------------------------------------------
# Five real MCP routes + conductor status HTTP route.
# ---------------------------------------------------------------------------
sr:route-kubectl a prov:Entity ; dct:identifier "kubectl" ; sr:routePath "/kubectl/sse" ; sr:transportKind sr:SSE .
sr:route-jaeger a prov:Entity ; dct:identifier "jaeger" ; sr:routePath "/jaeger/sse" ; sr:transportKind sr:SSE .
sr:route-loki a prov:Entity ; dct:identifier "loki" ; sr:routePath "/loki/sse" ; sr:transportKind sr:SSE .
sr:route-prometheus a prov:Entity ; dct:identifier "prometheus" ; sr:routePath "/prometheus/sse" ; sr:transportKind sr:SSE .
sr:route-submit a prov:Entity ; dct:identifier "submit" ; sr:routePath "/submit_mcp/sse" ; sr:transportKind sr:SSE .
sr:route-status a prov:Entity ; dct:identifier "status" ; sr:routePath "/status" ; sr:transportKind sr:HTTP .

# ---------------------------------------------------------------------------
# Exact 14 GymAct capabilities.  11 are information-only READ; only kubectl
# and the two semantic submit bindings are DO.  The real kernel has a named
# READ operation and mechanically refuses READ through DO, so the historical
# all-DO workaround is intentionally not carried forward.
# ---------------------------------------------------------------------------
<urn:gymact:sregym:capability:observe_cluster_state> a sosa:Procedure, sr:Capability ;
    dct:title "Read SREGym conductor status" ; sr:binding "observe_cluster_state" ; sr:consequence sr:READ ;
    dct:relation sr:route-status ; sr:authorityRequired false .
<urn:gymact:sregym:capability:get_benchmark_status> a sosa:Procedure, sr:Capability ;
    dct:title "Read SREGym benchmark stage" ; sr:binding "get_benchmark_status" ; sr:consequence sr:READ ;
    dct:relation sr:route-status ; sr:authorityRequired false .
<urn:gymact:sregym:capability:run_kubectl> a sosa:Procedure, sr:Capability ;
    dct:title "Execute kubectl through SREGym kubectl MCP" ; sr:binding "run_kubectl" ; sr:consequence sr:DO ;
    dct:relation sr:route-kubectl ; sr:toolName "exec_kubectl_cmd_safely" ; sr:authorityRequired true ;
    sr:payloadSchemaJson "{\"type\":\"object\",\"required\":[\"command\"],\"properties\":{\"command\":{\"type\":\"string\",\"minLength\":1}},\"additionalProperties\":false}" .
<urn:gymact:sregym:capability:submit_diagnosis> a sosa:Procedure, sr:Capability ;
    dct:title "Submit diagnosis through SREGym submit MCP" ; sr:binding "submit_diagnosis" ; sr:consequence sr:DO ;
    dct:relation sr:route-submit ; sr:toolName "submit" ; sr:authorityRequired true .
<urn:gymact:sregym:capability:submit_mitigation> a sosa:Procedure, sr:Capability ;
    dct:title "Submit mitigation through SREGym submit MCP" ; sr:binding "submit_mitigation" ; sr:consequence sr:DO ;
    dct:relation sr:route-submit ; sr:toolName "submit" ; sr:authorityRequired true .

<urn:gymact:sregym:capability:jaeger_get_services> a sosa:Procedure, sr:Capability ; dct:title "Jaeger get_services" ; sr:binding "jaeger_get_services" ; sr:consequence sr:READ ; dct:relation sr:route-jaeger ; sr:toolName "get_services" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:jaeger_get_operations> a sosa:Procedure, sr:Capability ; dct:title "Jaeger get_operations" ; sr:binding "jaeger_get_operations" ; sr:consequence sr:READ ; dct:relation sr:route-jaeger ; sr:toolName "get_operations" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:jaeger_get_traces> a sosa:Procedure, sr:Capability ; dct:title "Jaeger get_traces" ; sr:binding "jaeger_get_traces" ; sr:consequence sr:READ ; dct:relation sr:route-jaeger ; sr:toolName "get_traces" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:jaeger_get_dependency_graph> a sosa:Procedure, sr:Capability ; dct:title "Jaeger get_dependency_graph" ; sr:binding "jaeger_get_dependency_graph" ; sr:consequence sr:READ ; dct:relation sr:route-jaeger ; sr:toolName "get_dependency_graph" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:loki_get_logs> a sosa:Procedure, sr:Capability ; dct:title "Loki get_logs" ; sr:binding "loki_get_logs" ; sr:consequence sr:READ ; dct:relation sr:route-loki ; sr:toolName "get_logs" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:loki_get_labels> a sosa:Procedure, sr:Capability ; dct:title "Loki get_labels" ; sr:binding "loki_get_labels" ; sr:consequence sr:READ ; dct:relation sr:route-loki ; sr:toolName "get_labels" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:loki_get_label_values> a sosa:Procedure, sr:Capability ; dct:title "Loki get_label_values" ; sr:binding "loki_get_label_values" ; sr:consequence sr:READ ; dct:relation sr:route-loki ; sr:toolName "get_label_values" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:prometheus_get_metrics> a sosa:Procedure, sr:Capability ; dct:title "Prometheus get_metrics" ; sr:binding "prometheus_get_metrics" ; sr:consequence sr:READ ; dct:relation sr:route-prometheus ; sr:toolName "get_metrics" ; sr:authorityRequired false .
<urn:gymact:sregym:capability:prometheus_get_alerts> a sosa:Procedure, sr:Capability ; dct:title "Prometheus get_alerts" ; sr:binding "prometheus_get_alerts" ; sr:consequence sr:READ ; dct:relation sr:route-prometheus ; sr:toolName "get_alerts" ; sr:authorityRequired false .

# DO is permitted only through GymAct's consequence boundary; MCP transport
# validity does not itself grant authority.
<urn:gymact:sregym:mcp-do-policy> a odrl:Policy ;
    odrl:permission [ a odrl:Permission ; odrl:action <urn:gymact:operation:act> ; odrl:target sr:DO ] .

