---
to: "wit/sregym-e2e.wit"
sparql:
  contract: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT (STR(?source) AS ?repository) ?revision WHERE {
      <urn:gymact:sregym:e2e:contract> dct:source ?source ; dct:hasVersion ?revision .
    }
  capability_count: |
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability . }
  read_count: |
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability ; sr:consequence sr:READ . }
  do_count: |
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability ; sr:consequence sr:DO . }
  corpus_count: |
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?subject) AS ?count) WHERE { ?subject a sr:CorpusSubject . }
  program_count: |
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?program) AS ?count) WHERE { ?program a sr:Program . }
---
// GENERATED by ggen from the admitted SREGym MCP graph.
// repository={{ contract[0].repository }}
// revision={{ contract[0].revision }}
// capability-count={{ capability_count[0].count }}
// read-count={{ read_count[0].count }}
// do-count={{ do_count[0].count }}
// corpus-count={{ corpus_count[0].count }}
// deterministic-program-count={{ program_count[0].count }}
// structural-admission-is-alive=false

package gymact:sregym-e2e@0.2.0;

interface sregym-e2e-verifier {
    record structural-contract {
        repository: string,
        revision: string,
        capability-count: u32,
        read-count: u32,
        do-count: u32,
        corpus-count: u32,
        deterministic-program-count: u32,
    }

    enum structural-disposition {
        admitted,
        refused,
    }

    contract: func() -> structural-contract;
    verify-structure: func(observed: structural-contract) -> structural-disposition;
}

world sregym-e2e-world {
    export sregym-e2e-verifier;
}
