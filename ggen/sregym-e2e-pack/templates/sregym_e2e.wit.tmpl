---
to: "wit/sregym-e2e.wit"
sparql:
  package: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id WHERE {
      <urn:gymact:sregym:e2e:wit-package> dct:identifier ?id .
    }
  interface: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id WHERE {
      <urn:gymact:sregym:e2e:wit-interface> dct:identifier ?id .
    }
  world: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id WHERE {
      <urn:gymact:sregym:e2e:wit-world> dct:identifier ?id .
    }
  contract: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT (STR(?source) AS ?repository) ?revision (STR(?capability) AS ?capability_iri)
    WHERE {
      <urn:gymact:sregym:e2e:contract>
        dct:source ?source ;
        dct:hasVersion ?revision ;
        dct:relation ?capability .
    }
---
// GENERATED by ggen from the admitted SREGym E2E graph.
// repository={{ contract[0].repository }}
// revision={{ contract[0].revision }}
// capability={{ contract[0].capability_iri }}

package {{ package[0].id }};

interface {{ interface[0].id }} {
    record subject {
        repository: string,
        revision: string,
        capability-iri: string,
    }

    record evidence {
        state-key: string,
        state-value: bool,
        receipt-operations: list<string>,
        evidence-ids: list<string>,
    }

    enum disposition {
        alive,
        refused,
    }

    contract-subject: func() -> subject;
    verify: func(subject: subject, evidence: evidence) -> disposition;
}

world {{ world[0].id }} {
    export {{ interface[0].id }};
}
