---
to: "tests/sregym_e2e_contract_proof.rs"
sparql:
  contract: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT (STR(?source) AS ?repository) ?revision WHERE {
      <urn:gymact:sregym:e2e:contract> dct:source ?source ; dct:hasVersion ?revision .
    }
  capability_count: |
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability . }
  read_count: |
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability ; sr:consequence sr:READ . }
  do_count: |
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE { ?cap a sosa:Procedure, sr:Capability ; sr:consequence sr:DO . }
  corpus_count: |
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?subject) AS ?count) WHERE { ?subject a sr:CorpusSubject . }
  program_count: |
    PREFIX sr: <urn:gymact:sregym:mcp:>
    SELECT (COUNT(DISTINCT ?program) AS ?count) WHERE { ?program a sr:Program . }
---
//! GENERATED cross-projection structural proof for SREGym.

#[path = "../src/sregym_e2e_contract.rs"]
mod contract;

use contract::{ObservedStructure, StructuralDisposition};

#[test]
fn rust_contract_matches_the_admitted_graph() {
    assert_eq!(contract::CONTRACT.repository, "{{ contract[0].repository }}");
    assert_eq!(contract::CONTRACT.revision, "{{ contract[0].revision }}");
    assert_eq!(contract::CONTRACT.capability_count, {{ capability_count[0].count }});
    assert_eq!(contract::CONTRACT.read_count, {{ read_count[0].count }});
    assert_eq!(contract::CONTRACT.do_count, {{ do_count[0].count }});
    assert_eq!(contract::CONTRACT.corpus_count, {{ corpus_count[0].count }});
    assert_eq!(contract::CONTRACT.deterministic_program_count, {{ program_count[0].count }});
    assert!(!contract::STRUCTURAL_ADMISSION_IS_ALIVE);
}

#[test]
fn exact_structure_is_admitted() {
    let observed = ObservedStructure {
        repository: "{{ contract[0].repository }}",
        revision: "{{ contract[0].revision }}",
        capability_count: {{ capability_count[0].count }},
        read_count: {{ read_count[0].count }},
        do_count: {{ do_count[0].count }},
        corpus_count: {{ corpus_count[0].count }},
        deterministic_program_count: {{ program_count[0].count }},
    };
    assert_eq!(contract::verify_structure(observed), StructuralDisposition::Admitted);
}

#[test]
fn drift_is_refused() {
    let revision_drift = ObservedStructure {
        repository: "{{ contract[0].repository }}",
        revision: "not-the-admitted-revision",
        capability_count: {{ capability_count[0].count }},
        read_count: {{ read_count[0].count }},
        do_count: {{ do_count[0].count }},
        corpus_count: {{ corpus_count[0].count }},
        deterministic_program_count: {{ program_count[0].count }},
    };
    assert_eq!(contract::verify_structure(revision_drift), StructuralDisposition::Refused);

    let surface_drift = ObservedStructure {
        repository: "{{ contract[0].repository }}",
        revision: "{{ contract[0].revision }}",
        capability_count: {{ capability_count[0].count }} + 1,
        read_count: {{ read_count[0].count }},
        do_count: {{ do_count[0].count }},
        corpus_count: {{ corpus_count[0].count }},
        deterministic_program_count: {{ program_count[0].count }},
    };
    assert_eq!(contract::verify_structure(surface_drift), StructuralDisposition::Refused);
}

#[test]
fn wit_projection_carries_the_same_structural_identity() {
    let wit = std::fs::read_to_string("wit/sregym-e2e.wit").expect("generated WIT");
    assert!(wit.contains("package gymact:sregym-e2e@0.2.0;"));
    assert!(wit.contains("interface sregym-e2e-verifier"));
    assert!(wit.contains("world sregym-e2e-world"));
    assert!(wit.contains("revision={{ contract[0].revision }}"));
    assert!(wit.contains("capability-count={{ capability_count[0].count }}"));
    assert!(wit.contains("read-count={{ read_count[0].count }}"));
    assert!(wit.contains("do-count={{ do_count[0].count }}"));
    assert!(wit.contains("corpus-count={{ corpus_count[0].count }}"));
    assert!(wit.contains("deterministic-program-count={{ program_count[0].count }}"));
    assert!(wit.contains("structural-admission-is-alive=false"));
}
