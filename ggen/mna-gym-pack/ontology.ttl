@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mna: <urn:gymact:mna:> .

# Public-ontology ABox only. The domain vocabulary below is SKOS/prov data,
# never a private M&A TBox. The world is an independently-authored synthetic
# transaction process; no real company, board approval, security, or asset is
# represented or affected.

mna:analysis a skos:Concept ; skos:prefLabel "M&A analysis" .
mna:governance a skos:Concept ; skos:prefLabel "M&A governance" .
mna:simulated-close a skos:Concept ; skos:prefLabel "Synthetic transaction close" .

# Logical-agent kinds are SKOS data tags carried through public dct:type.
mna:logical-agent a skos:Concept ; skos:prefLabel "Logical agent projection" .
mna:observation-projection a skos:Concept ; skos:prefLabel "Observation projection" .
mna:action-projection a skos:Concept ; skos:prefLabel "Action projection" .
mna:ggen-pack a skos:Concept ; skos:prefLabel "ggen pack" .

mna:objective-minimize-flow-time a skos:Concept ;
    skos:prefLabel "Minimize flow time while preserving verified throughput" .

mna:planner-deterministic-workflow a prov:Plan ;
    dct:identifier "deterministic-workflow" ;
    dct:title "Deterministic workflow planner" .

mna:pack-mna a prov:Entity ;
    dct:identifier "mna-gym-pack" ;
    dct:type mna:ggen-pack .

mna:key-facts a prov:Entity ; dct:identifier "facts" .
mna:key-goal-reached a prov:Entity ; dct:identifier "goal_reached" .
mna:key-capability a prov:Entity ; dct:identifier "capability" .
mna:key-payload a prov:Entity ; dct:identifier "payload" .

mna:projection-mna-state a prov:Entity ;
    dct:type mna:observation-projection ;
    dct:hasPart mna:key-facts, mna:key-goal-reached .

mna:projection-capability-payload a prov:Entity ;
    dct:type mna:action-projection ;
    dct:hasPart mna:key-capability, mna:key-payload .

mna:role-strategy a prov:Role ; dct:title "Strategy" .
mna:role-diligence a prov:Role ; dct:title "Diligence" .
mna:role-finance a prov:Role ; dct:title "Finance" .
mna:role-regulatory a prov:Role ; dct:title "Regulatory" .
mna:role-integration a prov:Role ; dct:title "Integration" .
mna:role-governance a prov:Role ; dct:title "Governance" .

mna:association-strategy a prov:Association ;
    prov:agent mna:agent-strategy ;
    prov:hadRole mna:role-strategy ;
    prov:hadPlan mna:planner-deterministic-workflow .

mna:association-diligence a prov:Association ;
    prov:agent mna:agent-diligence ;
    prov:hadRole mna:role-diligence ;
    prov:hadPlan mna:planner-deterministic-workflow .

mna:association-finance a prov:Association ;
    prov:agent mna:agent-finance ;
    prov:hadRole mna:role-finance ;
    prov:hadPlan mna:planner-deterministic-workflow .

mna:association-regulatory a prov:Association ;
    prov:agent mna:agent-regulatory ;
    prov:hadRole mna:role-regulatory ;
    prov:hadPlan mna:planner-deterministic-workflow .

mna:association-integration a prov:Association ;
    prov:agent mna:agent-integration ;
    prov:hadRole mna:role-integration ;
    prov:hadPlan mna:planner-deterministic-workflow .

mna:association-governance a prov:Association ;
    prov:agent mna:agent-governance ;
    prov:hadRole mna:role-governance ;
    prov:hadPlan mna:planner-deterministic-workflow .

mna:agent-strategy a prov:Agent ;
    dct:identifier "mna-strategy" ;
    dct:type mna:logical-agent ;
    dct:subject mna:objective-minimize-flow-time ;
    dct:relation mna:projection-mna-state, mna:projection-capability-payload, mna:pack-mna ;
    dct:extent "1"^^xsd:integer ;
    prov:qualifiedAssociation mna:association-strategy .

mna:agent-diligence a prov:Agent ;
    dct:identifier "mna-diligence" ;
    dct:type mna:logical-agent ;
    dct:subject mna:objective-minimize-flow-time ;
    dct:relation mna:projection-mna-state, mna:projection-capability-payload, mna:pack-mna ;
    dct:extent "1"^^xsd:integer ;
    prov:qualifiedAssociation mna:association-diligence .

mna:agent-finance a prov:Agent ;
    dct:identifier "mna-finance" ;
    dct:type mna:logical-agent ;
    dct:subject mna:objective-minimize-flow-time ;
    dct:relation mna:projection-mna-state, mna:projection-capability-payload, mna:pack-mna ;
    dct:extent "1"^^xsd:integer ;
    prov:qualifiedAssociation mna:association-finance .

mna:agent-regulatory a prov:Agent ;
    dct:identifier "mna-regulatory" ;
    dct:type mna:logical-agent ;
    dct:subject mna:objective-minimize-flow-time ;
    dct:relation mna:projection-mna-state, mna:projection-capability-payload, mna:pack-mna ;
    dct:extent "1"^^xsd:integer ;
    prov:qualifiedAssociation mna:association-regulatory .

mna:agent-integration a prov:Agent ;
    dct:identifier "mna-integration" ;
    dct:type mna:logical-agent ;
    dct:subject mna:objective-minimize-flow-time ;
    dct:relation mna:projection-mna-state, mna:projection-capability-payload, mna:pack-mna ;
    dct:extent "1"^^xsd:integer ;
    prov:qualifiedAssociation mna:association-integration .

mna:agent-governance a prov:Agent ;
    dct:identifier "mna-governance" ;
    dct:type mna:logical-agent ;
    dct:subject mna:objective-minimize-flow-time ;
    dct:relation mna:projection-mna-state, mna:projection-capability-payload, mna:pack-mna ;
    dct:extent "1"^^xsd:integer ;
    prov:qualifiedAssociation mna:association-governance .

mna:artifact-strategic-thesis a prov:Entity ; dct:title "Strategic transaction thesis" .
mna:artifact-target-screen a prov:Entity ; dct:title "Target-screen evidence" .
mna:artifact-commercial-diligence a prov:Entity ; dct:title "Commercial diligence" .
mna:artifact-financial-diligence a prov:Entity ; dct:title "Financial diligence" .
mna:artifact-technology-diligence a prov:Entity ; dct:title "Technology diligence" .
mna:artifact-cyber-diligence a prov:Entity ; dct:title "Cyber diligence" .
mna:artifact-people-diligence a prov:Entity ; dct:title "People diligence" .
mna:artifact-valuation a prov:Entity ; dct:title "Valuation model" .
mna:artifact-transaction-structure a prov:Entity ; dct:title "Transaction structure" .
mna:artifact-regulatory-analysis a prov:Entity ; dct:title "Regulatory and antitrust analysis" .
mna:artifact-financing-plan a prov:Entity ; dct:title "Financing plan" .
mna:artifact-integration-architecture a prov:Entity ; dct:title "Integration architecture" .
mna:artifact-board-approval a prov:Entity ; dct:title "Synthetic board approval" .
mna:artifact-simulated-close a prov:Entity ; dct:title "Synthetic close receipt" .

mna:task-00-thesis a pplan:Plan ;
    dct:identifier "mna.00.strategic-thesis" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-strategy ;
    dct:subject mna:artifact-strategic-thesis .

mna:task-10-screen a pplan:Plan ;
    dct:identifier "mna.10.target-screen" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-strategy ;
    dct:subject mna:artifact-target-screen .

mna:task-20-diligence a pplan:Plan ;
    dct:identifier "mna.20.diligence" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-diligence ;
    dct:subject
        mna:artifact-commercial-diligence,
        mna:artifact-financial-diligence,
        mna:artifact-technology-diligence,
        mna:artifact-cyber-diligence,
        mna:artifact-people-diligence .

mna:task-30-valuation a pplan:Plan ;
    dct:identifier "mna.30.valuation" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-finance ;
    dct:subject mna:artifact-valuation .

mna:task-40-structure a pplan:Plan ;
    dct:identifier "mna.40.transaction-structure" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-finance ;
    dct:subject mna:artifact-transaction-structure .

mna:task-50-regulatory a pplan:Plan ;
    dct:identifier "mna.50.regulatory-analysis" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-regulatory ;
    dct:subject mna:artifact-regulatory-analysis .

mna:task-60-financing a pplan:Plan ;
    dct:identifier "mna.60.financing" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-finance ;
    dct:subject mna:artifact-financing-plan .

mna:task-70-integration a pplan:Plan ;
    dct:identifier "mna.70.integration-architecture" ;
    dct:type mna:analysis ;
    dct:contributor mna:agent-integration ;
    dct:subject mna:artifact-integration-architecture .

mna:task-80-board a pplan:Plan ;
    dct:identifier "mna.80.board-approval" ;
    dct:type mna:governance ;
    dct:contributor mna:agent-governance ;
    dct:subject mna:artifact-board-approval .

mna:task-90-close a pplan:Plan ;
    dct:identifier "mna.90.simulated-close" ;
    dct:type mna:simulated-close ;
    dct:contributor mna:agent-governance ;
    dct:subject mna:artifact-simulated-close .

# This permission is descriptive evidence that the synthetic close is a
# governed capability. Runtime admission remains external via the injected
# AuthorityResolver; the ontology never self-authorizes an actuation.
mna:close-policy a odrl:Policy ;
    odrl:permission mna:close-permission .

mna:close-permission a odrl:Permission ;
    odrl:assigner mna:synthetic-board .

mna:synthetic-board a prov:Agent ;
    dct:title "Synthetic transaction board" .
