    if "{{ p.spotCheckService }}" not in topology.services_in_region("{{ p.spotCheckRegion }}"):
        problems.append("SPOT_CHECK_FAILED:{{ p.spotCheckService }}_not_in_{{ p.spotCheckRegion }}")
{% endif %}
{% if p.recountKind == "live" %}    stale, stale_reasons = False, ()
{% else %}    stale, stale_reasons = _staleness(topology.fetched_at)
{% endif %}    return ValidationResult(
        provider="{{ p.providerId }}",
        valid=not problems,
        problems=tuple(problems),
        stale=stale,
        stale_reasons=stale_reasons,
        independent_region_count=independent_regions,
        independent_service_count=independent_services,
        loaded_region_count=len(topology.regions),
