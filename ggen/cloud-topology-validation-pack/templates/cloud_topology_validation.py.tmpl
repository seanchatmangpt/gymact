{% if p.recountKind == "live" %}
def {{ p.independentRecountFunction }}(*, partition: str = "{{ p.providerId }}") -> tuple[int, int]:
    """Re-derives {{ p.providerId }} region/service counts directly from `botocore`'s bundled
    `endpoints.json`, via code that does NOT call `{{ p.loaderFunction }}()` -- a separate
    transform, so a bug in that function's own logic cannot hide from this check."""
    from botocore.loaders import create_loader

    data = create_loader().load_data("endpoints")
    real_partition = next(x for x in data["partitions"] if x.get("partition") == partition)
    return len(real_partition.get("regions", {})), len(real_partition.get("services", {}))
{% elif p.recountKind == "snapshot" %}
def {{ p.independentRecountFunction }}(path: Path) -> tuple[int, int]:
    """Re-parses the bundled {{ p.providerId }} snapshot file directly, via code that does NOT
    call `_load_snapshot_topology()`."""
    raw = json.loads(path.read_text())
    return len(raw.get("{{ p.snapshotRegionKey }}", [])), len(raw.get("{{ p.snapshotServiceKey }}", []))
{% endif %}

def validate_{{ p.providerId }}({% if p.recountKind == "snapshot" %}*, snapshot_path: Path = _{{ p.providerId | upper }}_SNAPSHOT_PATH{% endif %}) -> ValidationResult:
{% if p.recountKind == "live" %}    topology = {{ p.loaderFunction }}()
{% else %}    topology = {{ p.loaderFunction }}(snapshot_path=snapshot_path)
{% endif %}    problems = list(_structural_problems(topology))

{% if p.recountKind == "live" %}    independent_regions, independent_services = {{ p.independentRecountFunction }}()
{% else %}    independent_regions, independent_services = {{ p.independentRecountFunction }}(snapshot_path)
{% endif %}    if independent_regions != len(topology.regions):
        problems.append(
            f"REGION_COUNT_MISMATCH:loaded={len(topology.regions)},independent={independent_regions}"
        )
    if independent_services != len(topology.services):
        problems.append(
