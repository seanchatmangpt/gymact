---
to: "src/gymact/semantics/admission.py"
force: true
sparql:
  authorities: "PREFIX pa: <http://seanchatmangpt.github.io/packs/public-ontology-admission#> SELECT ?authorityId ?namespaceUri ?specUri ?publicationStatus ?sourceKind WHERE { ?a a pa:PublicAuthority ; pa:authorityId ?authorityId ; pa:namespaceUri ?namespaceUri ; pa:specUri ?specUri ; pa:publicationStatus ?publicationStatus ; pa:sourceKind ?sourceKind } ORDER BY ?authorityId"
  classes: "PREFIX pa: <http://seanchatmangpt.github.io/packs/public-ontology-admission#> SELECT ?authorityId ?className ?classIri ?classComment WHERE { ?c a pa:AdmittedClass ; pa:belongsTo ?a ; pa:className ?className ; pa:classIri ?classIri ; pa:classComment ?classComment . ?a pa:authorityId ?authorityId } ORDER BY ?classIri"
