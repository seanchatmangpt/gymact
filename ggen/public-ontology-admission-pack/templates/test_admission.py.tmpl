---
to: "tests/test_admission.py"
force: true
sparql:
  classes: "PREFIX pa: <http://seanchatmangpt.github.io/packs/public-ontology-admission#> SELECT ?classIri WHERE { ?c a pa:AdmittedClass ; pa:classIri ?classIri } ORDER BY ?classIri"
  authority_count: "PREFIX pa: <http://seanchatmangpt.github.io/packs/public-ontology-admission#> SELECT (COUNT(?a) AS ?n) WHERE { ?a a pa:PublicAuthority } ORDER BY ?n"
---
"""GENERATED by ggen from public-ontology-admission-pack/ontology.ttl -- do not hand-edit.

Chicago-style: real `is_admitted`/`classify` calls against the real generated registry, no
mocks. Proves both directions of the PUBLIC-ONLY ADMISSION policy: every ontology-admitted
class IRI is recognized, and an invented private class IRI is refused.
"""

from __future__ import annotations

from gymact.semantics.admission import SourceKind, classify, is_admitted

ONTOLOGY_ADMITTED_CLASS_IRIS = [
{% for row in classes -%}
    "{{ row.classIri }}",
{% endfor -%}
]

EXPECTED_AUTHORITY_COUNT = {{ authority_count.0.n }}


def test_every_ontology_admitted_class_is_recognized():
    for class_iri in ONTOLOGY_ADMITTED_CLASS_IRIS:
        assert is_admitted(class_iri) is True, class_iri


def test_a_real_prov_o_class_is_admitted_as_native_ontology():
    assert is_admitted("http://www.w3.org/ns/prov#Entity") is True
    assert classify("http://www.w3.org/ns/prov#Entity") == SourceKind.NATIVE_ONTOLOGY


def test_a_real_org_class_is_admitted_as_native_ontology():
    assert is_admitted("http://www.w3.org/ns/org#Organization") is True
    assert classify("http://www.w3.org/ns/org#Organization") == SourceKind.NATIVE_ONTOLOGY


def test_an_invented_private_class_is_refused():
    """The exact failure mode the admission law exists to prevent: a made-up class like
    `SonyApplication` must never be silently treated as admitted."""
    assert is_admitted("http://sony.example/SonyApplication") is False
    assert classify("http://sony.example/SonyApplication") is None


def test_registry_has_exactly_the_real_admitted_authority_count():
    from gymact.semantics.admission import PUBLIC_AUTHORITIES

    assert len(PUBLIC_AUTHORITIES) == EXPECTED_AUTHORITY_COUNT
