---
to: "wit/gymact-world-cyber.wit"
force: true
sparql:
  capabilities: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id WHERE { ?cap a sosa:Procedure ; dct:identifier ?id . } ORDER BY ?id
---
package gymact:world-cyber@0.1.0;

// Static cross-language catalog. Deliberately no socket, shell, process, HTTP,
// credential, or arbitrary-target operation is exported.
// Admitted capability identifiers:{% for row in capabilities %} {{ row.id }}{% endfor %}
interface catalog {
  record asset { id: string, title: string, domain: string }
  record dependency { source: string, requires: string }
  record capability { id: string, title: string, family: string, effect: string }
  assets: func() -> list<asset>;
  dependencies: func() -> list<dependency>;
  capabilities: func() -> list<capability>;
}

world world-cyber-catalog { export catalog; }
