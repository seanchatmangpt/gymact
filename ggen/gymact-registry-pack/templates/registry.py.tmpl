  excluded: "PREFIX rg: <http://seanchatmangpt.github.io/packs/gymact-registry#> SELECT ?excludedClass ?exclusionReason WHERE { ?e a rg:ExcludedProvider ; rg:excludedClass ?excludedClass ; rg:exclusionReason ?exclusionReason } ORDER BY ?excludedClass"
