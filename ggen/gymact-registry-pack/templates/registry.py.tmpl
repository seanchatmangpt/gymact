"""Built-in provider registry; semantic capability identity stays shared across transports.

GENERATED by ggen from ggen/gymact-registry-pack/ontology.ttl -- do not hand-edit. Adding a
new gym provider means adding an rg:RegisteredProvider individual to that ontology, not
editing this file's import block or `_BUILTINS` dict directly -- the generator cannot
"forget" a registration the way hand-editing two separate files (a new gym module plus this
dict) once did (see tests/test_registry_completeness_chicago.py's own docstring for the real
gap this closes: CloudTopologyProvider shipped without ever being registered here).
"""

from __future__ import annotations

from typing import Any

{% for p in providers %}{% if p.capabilitiesModule == p.providerModule %}from {{ p.providerModule }} import {{ p.providerClassName }}, {{ p.capabilitiesImportClause }}
{% else %}from {{ p.providerModule }} import {{ p.providerClassName }}
from {{ p.capabilitiesModule }} import {{ p.capabilitiesImportClause }}
{% endif %}{% endfor %}
# NOT registered here (deliberately, not an oversight):
{% for e in excluded %}#   - {{ e.excludedClass }}: {{ e.exclusionReason }}
{% endfor %}
_BUILTINS = {
{% for p in providers %}    "{{ p.registryKey }}": ({{ p.providerClassName }}, {{ p.capabilitiesExpr }}),
{% endfor %}}


def builtin_provider_names() -> tuple[str, ...]:
    return tuple(sorted(_BUILTINS))


def builtin_capabilities(name: str) -> tuple[Any, ...]:
    try:
        return _BUILTINS[name][1]
    except KeyError as exc:
        raise ValueError(f"UNKNOWN_BUILTIN_PROVIDER:{name}") from exc


def create_builtin_provider(name: str) -> Any:
    try:
        provider_type = _BUILTINS[name][0]
    except KeyError as exc:
        raise ValueError(f"UNKNOWN_BUILTIN_PROVIDER:{name}") from exc
    return provider_type()


def describe_builtin_provider(name: str) -> dict[str, Any]:
    provider = create_builtin_provider(name)
    return {
        "name": name,
        "type": type(provider).__name__,
        "materialization_requires_authority": bool(
            getattr(provider, "materialization_requires_authority", False)
        ),
        "capabilities": [item.model_dump(mode="json") for item in builtin_capabilities(name)],
    }
