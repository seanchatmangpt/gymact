---
to: "src/gymact_mcp_tools.rs"
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?consequence_class
    WHERE {
      ?cap a sosa:Procedure ;
           dct:title ?id ;
           dct:type ?consequence_class_iri .
      BIND(IF(CONTAINS(STR(?consequence_class_iri), "consequence:do"), "Do", "Read") AS ?consequence_class)
    }
    ORDER BY ?id
---
//! Generated MCP tool schema surface -- GENERATED by `ggen sync` from
//! `ggen/gymact-bridge-pack/ontology.ttl`. This is the genuinely new
//! template family this pack exists to prove: no existing pack in this
//! repo generates a working MCP tool/server schema from arbitrary domain
//! RDF facts (`rmcp-pack` only catalogs the `rmcp` SDK's own API surface;
//! `crates/ggen-mcp` is hand-written). The real GymAct MCP surface is
//! Python/FastMCP (`~/gymact/src/gymact/surfaces/fastmcp.py`), exposing 9
//! tools (`discover, create_episode, capabilities, observe, act, verify,
//! checkpoint, restore, teardown`) -- FastMCP derives those directly from
//! Python function type annotations, so it does not need this Rust
//! projection to run. Tool NAMES here deliberately don't attempt to mirror
//! the real FastMCP transport names 1:1 (`create_episode`/`capabilities`
//! are transport-only concepts with no `sosa:Procedure` counterpart in the
//! real profile); tool IDENTIFIERS (the 4 `dct:title` values) are real
//! GymAct `Operation` enum values, sourced from the same admitted graph
//! `gymact_operation_catalog.rs` projects, not invented here.
//!
//! `consequence_class` is surfaced as a schema field, not enforced here:
//! per GymAct's architecture, an MCP tool call manufactures an intent, it
//! never grants execution authority by itself -- and per the real profile
//! (`ontology/profile.ttl`, a real symlink into this same repo's own
//! `src/gymact/ontology/`), authority itself is Python-runtime-only
//! in GymAct today, not yet represented in RDF at all.
//!
//! Do not edit by hand: this is a pure projection of the admitted graph.

/// One generated MCP tool's schema (name and the real GymAct consequence
/// class it was classified under, per `urn:gymact:shape:capability`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct McpToolSchema {
    /// MCP tool name, namespaced under `gymact.` per this bridge's own
    /// convention (not the real FastMCP transport's tool names).
    pub name: &'static str,
    /// "Read" (sosa:Observation-shaped) or "Do" (sosa:Actuation-shaped),
    /// per GymAct's real `urn:gymact:consequence:{read,do}` classification.
    pub consequence_class: &'static str,
}

/// All {{ ops | length }} generated MCP tool schemas, one per admitted
/// `sosa:Procedure`, ordered by tool name.
pub const MCP_TOOLS: &[McpToolSchema] = &[
{% for row in ops -%}
    McpToolSchema { name: "gymact.{{ row.id }}", consequence_class: "{{ row.consequence_class }}" },
{% endfor -%}
];

/// Look up a generated tool schema by its full `gymact.<id>` name.
pub fn lookup_mcp_tool(name: &str) -> Option<&'static McpToolSchema> {
    MCP_TOOLS.iter().find(|t| t.name == name)
}

/// Tool schemas classified `Do` -- the subset whose real GymAct execution
/// (per `~/gymact/src/gymact/runtime.py`) requires a fail-closed
/// `AuthorityResolver` decision before it may cause a consequence.
pub fn do_class_tools() -> Vec<&'static McpToolSchema> {
    MCP_TOOLS
        .iter()
        .filter(|t| t.consequence_class == "Do")
        .collect()
}

/// Count of generated tool schemas.
pub fn mcp_tool_count() -> usize {
    MCP_TOOLS.len()
}
