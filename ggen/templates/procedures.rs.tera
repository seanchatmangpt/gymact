// GENERATED by ggen from the exported GymAct public semantic profile.
// Do not hand edit. The semantic authority is RDF + SHACL.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Procedure {
    pub iri: &'static str,
    pub title: &'static str,
    pub consequence: &'static str,
}

pub const PROCEDURES: &[Procedure] = &[
{% for result in results %}
    Procedure {
        iri: "{{ result.procedure }}",
        title: "{{ result.title }}",
        consequence: "{{ result.consequence }}",
    },
{% endfor %}
];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn generated_profile_contains_lifecycle_procedures() {
        assert!(PROCEDURES.len() >= 7);
        assert!(PROCEDURES
            .iter()
            .any(|item| item.iri == "urn:gymact:operation:materialize"));
        assert!(PROCEDURES
            .iter()
            .any(|item| item.iri == "urn:gymact:operation:teardown"));
    }
}
