def test_unknown_kind_raises_real_value_error() -> None:
    async def _run() -> None:
        env = K8sResourceEnvironment()
        cap = next(c for c in K8S_RESOURCE_CAPABILITIES if c.binding == "required_fields_for_kind")
        await env.actuate(cap, {"kind": "NotARealKind"})

    with pytest.raises(ValueError):
        asyncio.run(_run())


def test_full_provider_lifecycle_is_real() -> None:
    async def _run() -> None:
        provider = K8sResourceProvider()
        env = await provider.materialize(scenario=None, config={})
        observed = await env.observe()
        assert observed["kind_count"] == {{ kinds | length }}
        checkpoint = await env.checkpoint()
        await env.restore(checkpoint)
        await env.teardown()

    asyncio.run(_run())
